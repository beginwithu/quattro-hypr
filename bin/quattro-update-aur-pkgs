#!/bin/bash

# quattro:summary=Update AUR packages if any are installed

# mise exports GOROOT and GOBIN for its own Go. Unset both so /usr/bin/go uses
# its own toolchain when building Go PKGBUILDs from the AUR.
unset GOROOT GOBIN

if pacman -Qem >/dev/null; then
  if quattro-pkg-aur-accessible; then
    echo -e "\e[32m\nUpdate AUR packages\e[0m"
    yay -Sua --noconfirm --cleanafter --ignore gcc14,gcc14-libs || exit 1
    echo
  else
    echo -e "\e[31m\nAUR is unavailable (so skipping updates)\e[0m"
    echo
  fi
fi
