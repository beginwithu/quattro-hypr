#!/bin/bash

# quattro:summary=Take a screenshot
# quattro:group=capture
# quattro:args=[smart|region|windows|fullscreen] [copy|save|edit]
# quattro:examples=quattro screenshot | quattro capture screenshot region | quattro capture screenshot edit
# quattro:aliases=quattro screenshot

SCREENSHOT_DIR="${QUATTRO_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots}"
mkdir -p "$SCREENSHOT_DIR"

mode="smart"
action="both"
for arg in "$@"; do
  case "$arg" in
    smart|region|windows|fullscreen) mode="$arg" ;;
    output) mode="fullscreen" ;;
    copy) action="copy" ;;
    save) action="save" ;;
    edit) action="edit" ;;
  esac
done

out_file="$SCREENSHOT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

freeze_pid=""
cleanup_freeze() {
  [[ -n $freeze_pid ]] && kill "$freeze_pid" 2>/dev/null || true
}
trap cleanup_freeze EXIT

if command -v quattro-capture-region >/dev/null 2>&1; then
  mapfile -t region_out < <(quattro-capture-region "$mode" --keep-freeze 2>/dev/null) || exit 0
  freeze_pid="${region_out[0]:-}"
  geom="${region_out[1]:-}"
else
  geom=$(slurp 2>/dev/null) || exit 0
fi

[[ -n $geom ]] || exit 0
grim -g "$geom" "$out_file" || exit 1
cleanup_freeze
freeze_pid=""

if [[ $action == "edit" ]]; then
  wl-copy --type image/png < "$out_file" 2>/dev/null || true
  exec quattro-edit-image "$out_file"
elif [[ $action == "copy" ]]; then
  wl-copy --type image/png < "$out_file"
  rm -f "$out_file"
  if command -v quattro-notification-send >/dev/null 2>&1; then
    copied_title=$(quattro-i18n capture.screenshotCopied 2>/dev/null || echo "Screenshot copied to clipboard")
    quattro-notification-send "$copied_title" -t 2000 || true
  fi
else
  if [[ $action != "save" ]]; then
    wl-copy --type image/png < "$out_file" 2>/dev/null || true
    title=$(quattro-i18n capture.screenshotSavedCopied 2>/dev/null || echo "Screenshot saved and copied")
  else
    title=$(quattro-i18n capture.screenshotSaved 2>/dev/null || echo "Screenshot saved")
  fi
  if command -v quattro-notification-send >/dev/null 2>&1; then
    body=$(quattro-i18n capture.screenshotEditHint 2>/dev/null || echo "Open or edit with Super + ,")
    open_label=$(quattro-i18n capture.screenshotOpen 2>/dev/null || echo "Open")
    edit_label=$(quattro-i18n capture.screenshotEdit 2>/dev/null || echo "Edit")
    quattro-notification-send "$title" "$body" \
      -t 10000 --image "$out_file" \
      --action "$open_label" xdg-open \
      --action "$edit_label" quattro-edit-image \
      --with "$out_file" || true
  fi
fi
