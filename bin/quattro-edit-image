#!/bin/bash

# quattro:summary=Open an image in an available image editor
# quattro:args=<image-path>
# quattro:hidden=true

file="${1:-}"
[[ -n $file && -e $file ]] || exit 1

if command -v swappy >/dev/null 2>&1; then
  exec setsid uwsm-app -- swappy -f "$file"
elif command -v satty >/dev/null 2>&1; then
  exec setsid uwsm-app -- satty -f "$file"
elif command -v pinta >/dev/null 2>&1; then
  exec setsid uwsm-app -- pinta "$file"
else
  exec xdg-open "$file"
fi
