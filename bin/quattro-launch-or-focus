#!/bin/bash

# quattro:summary=Launch an app or focus an existing window matching a pattern
# quattro:args=<window-pattern> <launch-command>


set -uo pipefail

if (($# == 0)); then
  echo "Usage: quattro-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })" >/dev/null 2>&1 || hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
elif (( $# >= 2 )) && [[ -n $2 ]]; then
  exec setsid bash -c "$2"
else
  exec setsid uwsm-app -- "$WINDOW_PATTERN"
fi
