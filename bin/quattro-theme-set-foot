#!/bin/bash

# quattro:summary=Apply current Quattro theme colors and background alpha to running Foot terminals
# quattro:hidden=true

set -euo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
source "$QUATTRO_PATH/default/bash/lib-common.sh"

colors_toml=$HOME/.local/state/quattro/current/theme/colors.toml
foot_ini=$HOME/.local/state/quattro/current/theme/foot.ini

[[ -f $colors_toml ]] || exit 0

# Theme switches wait on this retint, and pgrep scans every process, so it runs
# once; each terminal's shells come from the kernel's list of its children.
foot_pids=$(pgrep -x foot) || exit 0

declare -A _foot_colors=()
while IFS=$'\t' read -r _k _v; do
  _foot_colors[$_k]="$_v"
done < <(quattro-theme-color --file "$colors_toml" --all 2>/dev/null)

foot_osc=""
[[ -n ${_foot_colors[foreground]:-} ]] && foot_osc+=$(printf '\033]10;%s\007' "${_foot_colors[foreground]}")
[[ -n ${_foot_colors[background]:-} ]] && foot_osc+=$(printf '\033]11;%s\007' "${_foot_colors[background]}")
[[ -n ${_foot_colors[cursor]:-} ]] && foot_osc+=$(printf '\033]12;%s\007' "${_foot_colors[cursor]}")
[[ -n ${_foot_colors[selection_background]:-} ]] && foot_osc+=$(printf '\033]17;%s\007' "${_foot_colors[selection_background]}")
[[ -n ${_foot_colors[selection_foreground]:-} ]] && foot_osc+=$(printf '\033]19;%s\007' "${_foot_colors[selection_foreground]}")
for _i in {0..15}; do
  [[ -n ${_foot_colors[color$_i]:-} ]] && foot_osc+=$(printf '\033]4;%d;%s\007' "$_i" "${_foot_colors[color$_i]}")
done
[[ -n $foot_osc ]] || exit 0

# foot takes a background alpha as an urxvt-style [percent] prefix, so a theme
# going see-through or back, as with Glassy windows, reaches running terminals.
# The last alpha in the theme's foot.ini wins, as it does when foot reads it.
alpha=""
if [[ -r $foot_ini ]]; then
  while IFS= read -r _line; do
    if [[ $_line =~ ^[[:space:]]*alpha[[:space:]]*=[[:space:]]*([0-9.]+) ]]; then
      alpha="${BASH_REMATCH[1]}"
    fi
  done <"$foot_ini"
fi
background="${_foot_colors[background]:-}"
if [[ -n $background ]]; then
  percent=$(awk -v alpha="${alpha:-1}" 'BEGIN { printf "%d", alpha * 100 + 0.5 }')
  foot_osc+=$(printf '\033]11;[%d]%s\007' "$percent" "$background")
fi

shopt -s nullglob
declare -A seen_ttys=()

for foot_pid in $foot_pids; do
  found_pty=0
  # Read the PTY index directly from foot's own /dev/ptmx master fds.
  # Privileged or file-capability children (like btop with cap_perfmon) set
  # PR_SET_DUMPABLE=0 and make /proc/<child>/fd/1 unreadable, whereas foot's
  # own fdinfo is always readable and works for both standalone foot and
  # foot --server.
  for fd_link in "/proc/$foot_pid/fd"/*; do
    [[ $(readlink "$fd_link" 2>/dev/null) == "/dev/ptmx" ]] || continue
    fd_num=${fd_link##*/}
    tty_index=""
    if [[ -r /proc/$foot_pid/fdinfo/$fd_num ]]; then
      while IFS= read -r _fline; do
        if [[ $_fline =~ ^tty-index:[[:space:]]*([0-9]+) ]]; then
          tty_index="${BASH_REMATCH[1]}"
          break
        fi
      done <"/proc/$foot_pid/fdinfo/$fd_num"
    fi
    if [[ $tty_index =~ ^[0-9]+$ ]]; then
      tty="/dev/pts/$tty_index"
      found_pty=1
      if [[ -z ${seen_ttys[$tty]:-} && -w $tty ]]; then
        seen_ttys[$tty]=1
        printf '%s' "$foot_osc" >"$tty" 2>/dev/null || true
      fi
    fi
  done

  # Fallback for kernels whose /proc/<pid>/fdinfo lacks tty-index.
  if (( found_pty == 0 )); then
    children="/proc/$foot_pid/task/$foot_pid/children"
    if [[ -e $children ]]; then
      { child_pids=$(<"$children"); } 2>/dev/null || continue
    else
      # A kernel built without CONFIG_PROC_CHILDREN keeps no such list.
      child_pids=$(pgrep -P "$foot_pid")
    fi
    for child_pid in $child_pids; do
      tty=$(readlink "/proc/$child_pid/fd/1" 2>/dev/null)
      if [[ $tty == /dev/pts/* && -z ${seen_ttys[$tty]:-} && -w $tty ]]; then
        seen_ttys[$tty]=1
        printf '%s' "$foot_osc" >"$tty" 2>/dev/null || true
      fi
    done
  fi
done
