#!/bin/bash

# quattro:summary=Show, list, or set the system monospace font
# quattro:group=font
# quattro:args=<current|list|set <font-name>>
# quattro:examples=quattro font current | quattro font list | quattro font set "JetBrainsMono Nerd Font"

set -euo pipefail

usage() {
  echo "Usage: quattro-font <current|list|set <font-name>>"
}

font_current() {
  fc-match monospace -f '%{family}\n' | head -n1 | cut -d, -f1
}

font_list() {
  fc-list :spacing=100 -f "%{family[0]}\n" | grep -v -i -E 'emoji|signwriting|quattro' | sort -u
}

font_set() {
  local font_name="${1:-}"
  if [[ -z $font_name ]]; then
    usage >&2
    exit 1
  fi

  if ! fc-list | grep -Fqi -- "$font_name"; then
    echo "Font '$font_name' not found." >&2
    exit 1
  fi

  if [[ -f ~/.config/foot/foot.ini ]]; then
    local foot_size
    foot_size="$(sed -n 's/^font=[^,]*:size=\([0-9.]\+\).*/\1/p' ~/.config/foot/foot.ini | head -1)"
    [[ -n $foot_size ]] || foot_size=9
    sed -i "s/^font=.*/font=$font_name:size=$foot_size/g" ~/.config/foot/foot.ini
  fi

  local fontconfig_file="$HOME/.config/fontconfig/fonts.conf"
  mkdir -p "$(dirname "$fontconfig_file")"
  cat >"$fontconfig_file" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$font_name</string>
    </edit>
  </match>
</fontconfig>
XML

  quattro-restart-shell

  if pgrep -x foot >/dev/null 2>&1; then
    quattro-notification-send -g  "$(quattro-i18n font.restartToSeeChange Foot)"
  fi

  quattro-hook font-set "$font_name"
}

cmd="${1:-}"
(( $# > 0 )) && shift || true

case "$cmd" in
  current) font_current ;;
  list) font_list ;;
  set) font_set "$@" ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
