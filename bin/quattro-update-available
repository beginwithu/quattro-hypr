#!/bin/bash

# quattro:summary=Check whether Quattro or Arch package updates are available.

set -euo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
updates=()

if git -C "$QUATTRO_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  upstream=$(git -C "$QUATTRO_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$QUATTRO_PATH" fetch --quiet 2>/dev/null || true

    behind=$(git -C "$QUATTRO_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("quattro $behind new $commit_label on $upstream")
    fi
  fi
fi

if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "Quattro is up to date"
  exit 1
fi
