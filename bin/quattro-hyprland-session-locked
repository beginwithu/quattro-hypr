#!/bin/bash

# quattro:summary=Returns true when the compositor holds a session lock (or a stranded one with --stranded <pid>)
# quattro:args=[--stranded <own-pid>]
# quattro:hidden=true

set -euo pipefail

stranded_pid=""
if [[ ${1:-} == "--stranded" ]]; then
  stranded_pid="${2:-}"
fi

monitors=$(hyprctl -j monitors 2>/dev/null) || exit 2

state=$(jq '
  def blockers: .solitaryBlockedBy // [];
  def readable: blockers | index("WORKSPACE") | not;

  if   any(.[]; blockers | index("LOCK")) then 0
  elif any(.[]; readable)                 then 1
  else                                         2
  end
' <<<"$monitors" 2>/dev/null || echo 2)

case "$state" in
  0)
    if [[ -n $stranded_pid ]]; then
      if pgrep -u "$UID" -x 'quickshell|qs|hyprlock' | grep -qvxF "$stranded_pid"; then
        exit 2
      fi
    fi
    exit 0
    ;;
  1) exit 1 ;;
  *) exit 2 ;;
esac
