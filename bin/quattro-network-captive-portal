#!/bin/bash

# quattro:summary=Open a captive portal's sign-in window until online
# quattro:group=network
# quattro:args=<url>

set -euo pipefail

url=${1:?Usage: quattro-network-captive-portal <url>}
lock=${XDG_RUNTIME_DIR:-/run/user/$UID}/quattro-network-captive-portal.lock

launcher=0

open_portal_window() {
  quattro-launch-browser --app="$url" 9>&- >/dev/null 2>&1 &
  launcher=$!
}

portal_window_failed() {
  if (( launcher )) && ! kill -0 "$launcher" 2>/dev/null; then
    local status=0
    wait "$launcher" || status=$?
    launcher=0
    (( status != 0 ))
  else
    false
  fi
}

close_portal_window() {
  local host=${url#*://}
  host=${host%%/*}
  local class="^.+?-${host//./[.]}__.*$"
  local seen=0

  for (( i = 0; i < 20; i++ )); do
    if hyprctl clients -j | jq -e --arg class "$class" 'any(.[]; .class | test($class))' >/dev/null; then
      seen=1
      hyprctl dispatch "hl.dsp.window.close({ window = \"class:$class\" })" >/dev/null
    elif (( seen )); then
      break
    fi
    sleep 0.3
  done
}

wait_until_online() {
  local fast_until=$(( SECONDS + 300 ))

  until [[ $(LC_ALL=C timeout 5 nmcli networking connectivity check 2>/dev/null) == "full" ]]; do
    if portal_window_failed; then
      exit 1
    fi
    if (( SECONDS < fast_until )); then
      sleep 2
    else
      sleep 15
    fi
  done
}

exec 9>"$lock"
if flock -n 9; then
  open_portal_window
  wait_until_online
  close_portal_window
else
  open_portal_window
fi
