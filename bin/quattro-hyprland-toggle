#!/bin/bash

# quattro:summary=Toggle permanent Hyprland flags or query their state
# quattro:group=hyprland
# quattro:name=toggle
# quattro:args=<--enabled <flag>|--disabled <flag>|--animations-off|<flag-name> [on|off|toggle]>

set -euo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
TOGGLES_DIR="$HOME/.local/state/quattro/toggles/hypr"

usage() {
  echo "Usage: quattro-hyprland-toggle <--enabled <flag>|--disabled <flag>|--animations-off|<flag-name> [on|off|toggle]>" >&2
  exit 1
}

is_enabled() {
  [[ -f "$TOGGLES_DIR/${1:-}.lua" ]]
}

is_disabled() {
  [[ ! -f "$TOGGLES_DIR/${1:-}.lua" ]]
}

animations_off() {
  is_enabled no-animations ||
    {
      [[ -e ${XDG_RUNTIME_DIR:-}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/quattro-software-rendering ]] &&
        ! quattro-toggle --enabled animations-without-gpu &&
        [[ $(hyprctl -j getoption animations:enabled 2>/dev/null | jq -r '.bool' 2>/dev/null || true) != "true" ]]
    }
}

(( $# >= 1 )) || usage

case "$1" in
  --enabled | enabled)
    (( $# >= 2 )) || usage
    is_enabled "$2"
    exit $?
    ;;
  --disabled | disabled)
    (( $# >= 2 )) || usage
    is_disabled "$2"
    exit $?
    ;;
  --animations-off | animations-off)
    animations_off
    exit $?
    ;;
esac

FLAG_NAME="$1"
ACTION="${2:-toggle}"
FLAG_FILE="$TOGGLES_DIR/$FLAG_NAME.lua"
FLAG_SOURCE="$QUATTRO_PATH/default/hypr/toggles/$FLAG_NAME.lua"

on() {
  if [[ -f $FLAG_SOURCE ]]; then
    mkdir -p "$TOGGLES_DIR"
    cp "$FLAG_SOURCE" "$FLAG_FILE"
  else
    echo "Flag not found: $FLAG_NAME" >&2
    exit 1
  fi
}

off() {
  rm -f "$FLAG_FILE"
}

toggle() {
  if [[ -f $FLAG_FILE ]]; then
    off
    echo "off"
  else
    on
    echo "on"
  fi
}

case "$ACTION" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  *) usage ;;
esac

quattro-restart hyprctl
