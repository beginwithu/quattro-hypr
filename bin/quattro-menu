#!/bin/bash

# quattro:summary=Control the Quattro menu, emoji picker, or timezone selector
# quattro:group=menu
# quattro:args=[toggle|summon|close|refresh|ping|emoji|emoji-insert <emoji>|timezone] [route]
# quattro:examples=quattro menu | quattro menu toggle system | quattro menu emoji | quattro menu timezone

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  if [[ $1 != *[\"\\$'\x01'-$'\x1f']* ]]; then
    printf '{"menu":"%s"}' "$1"
  else
    jq -nc --arg menu "$1" '{ menu: $menu }'
  fi
}

case "$verb" in
  toggle)
    exec quattro-shell shell toggle quattro.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec quattro-shell shell summon quattro.menu "$(menu_payload "$route")"
    ;;
  close)
    exec quattro-shell shell hide quattro.menu
    ;;
  refresh | ping)
    exec quattro-shell shell call quattro.menu "$verb" "{}"
    ;;
  emoji)
    exec quattro-shell shell toggle quattro.emojis
    ;;
  emoji-insert)
    emoji="${2:-}"
    [[ -n $emoji ]] || exit 0
    printf '%s' "$emoji" | wl-copy --sensitive --foreground &
    copy_pid=$!
    sleep 0.15
    if [[ $(hyprctl dispatch 'o.universal_paste' 2>/dev/null || true) != "ok" ]]; then
      wtype -M shift -k Insert -m shift 2>/dev/null || true
    fi
    sleep 0.3
    kill "$copy_pid" 2>/dev/null || true
    ;;
  timezone)
    timezone=$(timedatectl list-timezones | quattro-menu-select "$(quattro-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
    timedatectl set-timezone "$timezone"
    quattro-shell -q quattro.clock refresh
    quattro-notification-send "$(quattro-i18n timezone.changed "$timezone")"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: quattro menu [verb] [route]

Verbs:
  toggle [route]         Open the menu at <route>, or close it if already open. Default verb.
  summon [route]         Always open the menu (no close-if-visible toggle).
  close                  Close the menu if it is visible.
  refresh                Re-parse the menu JSONC files.
  ping                   Health check.
  emoji                  Toggle the emoji picker.
  emoji-insert <emoji>   Insert an emoji into the focused application.
  timezone               Pick and set the system timezone.
USAGE
    exit 0
    ;;
  *)
    echo "quattro-menu: unknown verb '$verb'. Try 'quattro menu --help'." >&2
    exit 2
    ;;
esac
