#!/bin/bash

# quattro:summary=Print the core package set required by Quattro
# quattro:hidden=true

set -eo pipefail

quattro_path="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
pkg_list="$quattro_path/packages/arch-core.packages"

if [[ ! -f $pkg_list ]]; then
  echo "Error: package list not found: $pkg_list" >&2
  exit 1
fi

sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$pkg_list" | awk '!seen[$0]++'
