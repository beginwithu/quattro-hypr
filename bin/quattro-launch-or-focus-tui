#!/bin/bash

# quattro:summary=Launch a TUI or focus an existing terminal window for it
# quattro:args=[--app-id=<app-id>] <command> [args...]


set -uo pipefail

if (( $# < 1 )); then
  echo "Usage: quattro-launch-or-focus-tui [--app-id=<app-id>] <command> [args...]" >&2
  exit 1
fi

if [[ $1 == --app-id=* ]]; then
  if (( $# < 2 )); then
    echo "Usage: quattro-launch-or-focus-tui [--app-id=<app-id>] <command> [args...]" >&2
    exit 1
  fi
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.quattro.${1##*/}"
fi

LAUNCH_COMMAND="quattro-launch-tui"
for arg in "$@"; do
  printf -v quoted_arg '%q' "$arg"
  LAUNCH_COMMAND+=" $quoted_arg"
done

exec quattro-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
