#!/bin/bash

# quattro:summary=Print a user-facing string in the current language
# quattro:args=[--count <n>] <key> [args...] | --number <value>
# quattro:hidden=true

set -euo pipefail

# Looks up <key> in default/i18n/<language>/cli.json, falling back to the
# English catalog and finally to the key itself. Catalog entries carry
# %1-style tokens (the same convention as the shell catalogs), substituted
# from the remaining arguments, so translations may reorder them freely.
# The language is read the same way quattro-language reads it; anything
# unexpected means English, the default.
#
# --count picks the form of a plural entry ({"one": ..., "other": ...}) by
# the language's plural rules in default/i18n/plural.jq. Arguments that are
# plain numbers are written with the language's decimal separator and
# digits from the registry, so "13.1" reads "13,1" in Danish. --number
# prints one number that way, for text that is not a catalog string.

count=null
number_only=0
if [[ ${1:-} == "--number" ]]; then
  if [[ ! ${2:-} =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    echo "Usage: quattro-i18n --number <value>" >&2
    exit 1
  fi
  number_only=1
  set -- __number "$2"
elif [[ ${1:-} == "--count" ]]; then
  if [[ ! ${2:-} =~ ^-?[0-9]+$ ]]; then
    echo "Usage: quattro-i18n [--count <n>] <key> [args...]" >&2
    exit 1
  fi
  count=$2
  shift 2
fi

key=${1:-}
if [[ -z $key ]]; then
  echo "Usage: quattro-i18n [--count <n>] <key> [args...]" >&2
  exit 1
fi
shift

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
i18n=$QUATTRO_PATH/default/i18n
language_file=${QUATTRO_LANGUAGE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/quattro/language}
language=en
if [[ -f $language_file ]]; then
  # Builtins only: head and tr would cost two process starts on every lookup.
  candidate=
  read -r candidate <"$language_file" || true
  candidate=${candidate//[[:space:]]/}
  if [[ $candidate =~ ^[a-z]{2,3}(-[A-Za-z]{2})?$ && -f $i18n/$candidate/cli.json ]]; then
    language=$candidate
  fi
fi

language_catalog=$i18n/$language/cli.json
[[ -f $language_catalog ]] || language_catalog=/dev/null
english_catalog=$i18n/en/cli.json
[[ -f $english_catalog ]] || english_catalog=/dev/null
registry=$i18n/locales.json
[[ -f $registry ]] || registry=/dev/null

# Fast path for English (decimal ".", ASCII digits, standard 1/-1 singular rule):
# resolves plain and plural strings directly in Bash without forking jq (~0.4ms vs ~12ms),
# falling back to jq if an entry contains JSON backslash escapes.
lookup_en_fast() {
  local line prefix="  \"$key\": " val="" in_obj=0 one_val="" other_val="" found_key=0
  [[ -f $english_catalog ]] || return 1

  while IFS= read -r line; do
    if (( in_obj )); then
      if [[ $line == "  }"* ]]; then
        break
      elif [[ $line =~ ^[[:space:]]*\"one\":[[:space:]]*\"(.*)\",?$ ]]; then
        one_val="${BASH_REMATCH[1]}"
      elif [[ $line =~ ^[[:space:]]*\"other\":[[:space:]]*\"(.*)\",?$ ]]; then
        other_val="${BASH_REMATCH[1]}"
      fi
    elif [[ $line == "$prefix"* ]]; then
      found_key=1
      val="${line#"$prefix"}"
      if [[ $val == "{"* ]]; then
        in_obj=1
      elif [[ $val =~ ^\"(.*)\",?$ ]]; then
        val="${BASH_REMATCH[1]}"
        [[ $val == *\\* ]] && return 1
        EN_RESULT="$val"
        return 0
      else
        return 1
      fi
    elif [[ $line == *"\"$key\""* ]]; then
      return 1
    fi
  done <"$english_catalog"

  if (( in_obj )); then
    [[ $one_val == *\\* || $other_val == *\\* ]] && return 1
    if [[ $count != "null" ]] && (( count == 1 || count == -1 )); then
      EN_RESULT="${one_val:-$other_val}"
    else
      EN_RESULT="$other_val"
    fi
    [[ -n $EN_RESULT ]] || EN_RESULT="$key"
    return 0
  fi

  (( found_key == 0 )) || return 1
  EN_RESULT="$key"
  return 0
}

parts=()
if [[ $language == "en" ]]; then
  if (( number_only )); then
    printf '%s' "$1"
    exit 0
  elif lookup_en_fast; then
    parts=("$EN_RESULT" "$@")
  fi
fi

# One jq run picks the string and localizes the arguments; the results come
# back NUL-separated so a string may itself span lines. The -- after --args
# keeps an argument that starts with a dash (a label like "-work") from being
# read as a jq option.
if (( ${#parts[@]} == 0 )); then
  jq_lang_args=(--slurpfile lang "$language_catalog")
  [[ $language == "en" ]] && jq_lang_args=(--argjson lang '[{}]')
  mapfile -d '' parts < <(jq -j -n -L "$i18n" \
    --arg key "$key" --arg language "$language" --argjson count "$count" \
    "${jq_lang_args[@]}" --slurpfile en "$english_catalog" --slurpfile registry "$registry" '
    include "plural";
    def present: . != null and . != "";
    ($lang[0] // {}) as $l | ($en[0] // {}) as $e | ($registry[0][$language] // {}) as $r
    | (if ($l[$key] | present) then [$l[$key], $language]
       elif ($e[$key] | present) then [$e[$key], "en"]
       else [$key, "en"] end) as [$entry, $from]
    | (if $count == null then (if ($entry | type) == "object" then $entry.other else $entry end)
       else ($entry | plural_pick($from; $count)) end) as $string
    | [$string // $key] + ($ARGS.positional | map(localize_number($r.decimal // "."; $r.zeroDigit // "0")))
    | map(tostring + "\u0000") | add
  ' --args -- "$@" 2>/dev/null) || true
fi

if (( ${#parts[@]} == 0 )); then
  parts=("$key" "$@")
fi
if (( number_only )); then
  printf '%s' "${parts[1]}"
  exit 0
fi
string=${parts[0]}
args=("${parts[@]:1}")

# Substitute through sentinels so an argument that itself contains a %N
# sequence is never substituted twice.
if (( ${#args[@]} > 0 )); then
  for (( i = 1; i <= ${#args[@]}; i++ )); do
    string=${string//%$i/$'\001'"$i"$'\002'}
  done
  for (( i = 1; i <= ${#args[@]}; i++ )); do
    # Quoted, or patsub_replacement would expand & in an argument to the
    # matched sentinel instead of keeping it literal.
    string=${string//$'\001'"$i"$'\002'/"${args[i - 1]}"}
  done
fi

printf '%s' "$string"
