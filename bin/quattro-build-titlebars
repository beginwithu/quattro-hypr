#!/bin/bash

# quattro:summary=Build the Hyprland floating window titlebars plugin
# quattro:args=[--system|--user] [--force]

set -euo pipefail

MODE=""
SRC_DIR=""
FORCE=false

while (( $# > 0 )); do
  case "$1" in
    --system) MODE="system" ;;
    --user) MODE="user" ;;
    --force) FORCE=true ;;
    --source)
      shift
      [[ $# -gt 0 ]] || { echo "quattro-build-titlebars: --source requires a directory" >&2; exit 1; }
      SRC_DIR="$1"
      ;;
    -h|--help)
      echo "Usage: quattro-build-titlebars [--system|--user] [--force] [--source DIR]"
      exit 0
      ;;
    *)
      echo "Usage: quattro-build-titlebars [--system|--user] [--force] [--source DIR]" >&2
      exit 1
      ;;
  esac
  shift
done

if [[ -z $MODE ]]; then
  if (( EUID == 0 )); then
    MODE="system"
  else
    MODE="user"
  fi
fi

if [[ -z $SRC_DIR ]]; then
  if [[ $MODE == "system" ]]; then
    if [[ -f /usr/share/quattro/titlebars/main.cpp ]]; then
      SRC_DIR="/usr/share/quattro/titlebars"
    elif [[ -n ${QUATTRO_PATH:-} && -f $QUATTRO_PATH/default/hypr/titlebars/main.cpp ]]; then
      SRC_DIR="$QUATTRO_PATH/default/hypr/titlebars"
    fi
  else
    QUATTRO_DIR="${QUATTRO_PATH:-$HOME/.local/share/quattro}"
    if [[ -f $QUATTRO_DIR/default/hypr/titlebars/main.cpp ]]; then
      SRC_DIR="$QUATTRO_DIR/default/hypr/titlebars"
    elif [[ -f /usr/share/quattro/titlebars/main.cpp ]]; then
      SRC_DIR="/usr/share/quattro/titlebars"
    fi
  fi
fi

if [[ -z $SRC_DIR || ! -f $SRC_DIR/main.cpp ]]; then
  echo "quattro-build-titlebars: titlebars source directory not found" >&2
  exit 1
fi

for cmd in g++ pkg-config; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "quattro-build-titlebars: missing required build tool: $cmd" >&2
    exit 1
  fi
done

if ! pkg-config --exists hyprland; then
  echo "quattro-build-titlebars: hyprland development headers (hyprland.pc) not found" >&2
  exit 1
fi

if [[ $MODE == "system" ]]; then
  OUT_DIR="/usr/lib/quattro-hyprland-titlebars"
else
  OUT_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/quattro/titlebars"
fi
OUT_FILE="$OUT_DIR/titlebars.so"
STAMP_FILE="$OUT_DIR/.titlebars.stamp"

DEPS=(hyprland libdrm libinput libudev pixman-1 wayland-server xkbcommon)
read -r -a CFLAGS <<<"$(pkg-config --cflags "${DEPS[@]}")"
read -r -a LIBS <<<"$(pkg-config --libs "${DEPS[@]}")"

# -O2: the plugin runs inside the compositor's render loop on every frame with
# a floating window, so runtime speed matters more than the few extra seconds
# of (cached, fingerprinted, parallel) build time. Override with
# QUATTRO_TITLEBARS_OPT=-O1 for faster rebuilds on slow machines.
OPT_FLAG="${QUATTRO_TITLEBARS_OPT:--O2}"

SOURCES=(
  "$SRC_DIR/main.cpp"
  "$SRC_DIR/barDeco.cpp"
  "$SRC_DIR/BarPassElement.cpp"
  "$SRC_DIR/appName.cpp"
)

FINGERPRINT=""
if command -v sha256sum >/dev/null 2>&1; then
  HASH_FILES=("${SOURCES[@]}")
  for hdr in "$SRC_DIR"/*.hpp; do
    [[ -f $hdr ]] && HASH_FILES+=("$hdr")
  done
  FINGERPRINT=$({
    printf 'opt=%s\n' "$OPT_FLAG"
    g++ --version | head -n1
    pkg-config --modversion hyprland
    printf '%s\n' "${CFLAGS[*]}" "${LIBS[*]}"
    if command -v pacman >/dev/null 2>&1; then
      pacman -Q hyprland 2>/dev/null || true
    fi
    for abi_file in /usr/bin/Hyprland /usr/include/hyprland/src/version.h /usr/include/hyprland/src/plugins/PluginAPI.hpp; do
      [[ -e $abi_file ]] && stat -c '%n %Y %s' "$abi_file" 2>/dev/null || true
    done
    LC_ALL=C sha256sum "${HASH_FILES[@]}"
  } | sha256sum | awk '{print $1}')

  if ! $FORCE && [[ -f $OUT_FILE && -f $STAMP_FILE ]] && [[ $(<"$STAMP_FILE") == "$FINGERPRINT" ]]; then
    echo "Up to date: $OUT_FILE"
    exit 0
  fi
fi

TMP_DIR=$(mktemp -d)
cleanup() {
  local pids
  pids=$(jobs -p 2>/dev/null || true)
  if [[ -n $pids ]]; then
    kill $pids 2>/dev/null || true
    wait 2>/dev/null || true
  fi
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

JOBS=$(nproc 2>/dev/null || echo 1)
[[ $JOBS =~ ^[0-9]+$ && $JOBS -ge 1 ]] || JOBS=1

COMPILE_CXX=(g++)
if (( EUID != 0 )) && command -v ccache >/dev/null 2>&1; then
  COMPILE_CXX=(ccache g++)
fi

OBJS=()
ACTIVE_PIDS=()
BUILD_FAILED=0

for src in "${SOURCES[@]}"; do
  base="${src##*/}"
  obj="$TMP_DIR/${base%.cpp}.o"
  OBJS+=("$obj")
  "${COMPILE_CXX[@]}" -c -pipe -fPIC -std=c++23 "$OPT_FLAG" -fno-gnu-unique \
    "${CFLAGS[@]}" "$src" -o "$obj" &
  ACTIVE_PIDS+=("$!")
  if (( ${#ACTIVE_PIDS[@]} >= JOBS )); then
    wait "${ACTIVE_PIDS[0]}" || BUILD_FAILED=1
    ACTIVE_PIDS=("${ACTIVE_PIDS[@]:1}")
  fi
done

for pid in "${ACTIVE_PIDS[@]}"; do
  wait "$pid" || BUILD_FAILED=1
done
(( BUILD_FAILED == 0 )) || exit 1

g++ -shared -fPIC -fno-gnu-unique \
  "${OBJS[@]}" \
  -o "$TMP_DIR/titlebars.so" \
  "${LIBS[@]}" -lrt

mkdir -p "$OUT_DIR"
TMP_OUT="$OUT_DIR/.titlebars.so.$$"
if [[ $MODE == "system" ]]; then
  install -m 0755 -o root -g root "$TMP_DIR/titlebars.so" "$TMP_OUT"
else
  install -m 0755 "$TMP_DIR/titlebars.so" "$TMP_OUT"
fi
mv -f "$TMP_OUT" "$OUT_FILE"

if [[ -n $FINGERPRINT ]]; then
  TMP_STAMP="$OUT_DIR/.titlebars.stamp.$$"
  printf '%s\n' "$FINGERPRINT" >"$TMP_STAMP"
  if [[ $MODE == "system" ]]; then
    chown root:root "$TMP_STAMP"
  fi
  chmod 0644 "$TMP_STAMP"
  mv -f "$TMP_STAMP" "$STAMP_FILE"
fi

echo "Built $OUT_FILE"
