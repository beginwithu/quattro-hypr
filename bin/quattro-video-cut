#!/usr/bin/env python3

# quattro:summary=Interactive video trimmer for screen recordings and media files

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def resolve_quattro_path() -> str:
    env_path = os.environ.get("QUATTRO_PATH", "").strip()
    if env_path and Path(env_path, "shell").is_dir():
        return env_path
    script_root = Path(__file__).resolve().parent.parent
    if (script_root / "shell").is_dir():
        return str(script_root)
    user_share = Path.home() / ".local" / "share" / "quattro"
    if (user_share / "shell").is_dir():
        return str(user_share)
    return "/usr/share/quattro"


def probe_duration_ms(video_path: str) -> int:
    if not shutil.which("ffprobe"):
        return 0
    try:
        out = subprocess.check_output(
            [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                video_path,
            ],
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
        ).strip()
        return max(0, int(round(float(out) * 1000)))
    except Exception:
        return 0


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--"]
    if not args or args[0] in ("-h", "--help"):
        print("Usage: quattro-video-cut <video-file>")
        return 0 if args else 1

    video_path = str(Path(args[0]).expanduser().resolve())
    if not os.path.isfile(video_path):
        print(f"quattro-video-cut: file not found: {video_path}", file=sys.stderr)
        return 1

    quattro_path = resolve_quattro_path()
    os.environ["QUATTRO_PATH"] = quattro_path
    duration_ms = probe_duration_ms(video_path)

    payload = json.dumps(
        {
            "path": video_path,
            "durationMs": duration_ms,
        },
        separators=(",", ":"),
    )

    quattro_shell_bin = os.path.join(quattro_path, "bin", "quattro-shell")
    if os.path.isfile(quattro_shell_bin):
        res = subprocess.run(
            [quattro_shell_bin, "shell", "summon", "quattro.video-cut", payload],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
        if res.returncode == 0:
            return 0

    standalone_qml = os.path.join(quattro_path, "shell", "video-cut.qml")
    if shutil.which("quickshell") and os.path.isfile(standalone_qml):
        env = os.environ.copy()
        env["QUATTRO_VIDEO_CUT_PAYLOAD"] = payload
        subprocess.Popen(
            ["quickshell", "-n", "-p", standalone_qml],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return 0

    print("quattro-video-cut: Quickshell video cutter unavailable", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
