#!/usr/bin/python3
# quattro:summary=Play a realistic run of notifications to look at the notification UI
# quattro:hidden=true
"""A sample run of notifications, sent straight onto the session bus as an
app would: a stack building, a code to copy, a link to open, and desktop apps."""
import subprocess
import time

from gi.repository import Gio, GLib

BUS_NAME = "org.freedesktop.Notifications"
BUS_PATH = "/org/freedesktop/Notifications"
GAP = 3.2

NOTIFICATIONS = [
  dict(web="github.com", summary="Quattro",
       body="Alex: notification decks just landed on main, worth a look before the call"),
  dict(app="Signal", icon="signal-desktop", summary="Sam",
       body="Are you around later to test the new notifications?"),
  dict(web="mail.example.com", summary="New Email",
       body="Re: Quattro release notes"),
  dict(web="github.com", summary="Quattro", gap=0.7,
       body="Sam: pushed the spacing pass, take a look"),
  dict(web="github.com", summary="Quattro", gap=0.7,
       body="Alex: the two-line ones finally breathe"),
  dict(web="github.com", summary="Quattro",
       body="Latest build is up at https://github.com/beginwithu/quattro-hypr"),
  dict(web="mail.example.com", summary="Security",
       body="Your verification code is 482913"),
  dict(app="foot", icon="foot", summary="Tests passed",
       body="412 passed, 0 failed in <b>2m 14s</b>"),
  dict(app="Quattro", icon="quattro", summary="Quattro",
       body="Notification decks, one-click codes, and more"),
  dict(app="Spotify", icon="spotify", summary="Now playing",
       body="Money for Nothing - Dire Straits"),
  dict(app="Quattro", icon="system-software-update", summary="Updates available",
       body="14 packages, including linux and hyprland"),
]


def send(bus, n):
  app, icon, body = n.get("app", ""), n.get("icon", ""), n["body"]
  if n.get("web"):
    app, icon = "Chromium", "chromium"
    body = '<a href="https://%s/">%s</a>\n\n%s' % (n["web"], n["web"], body)
  actions = []
  for action in n.get("actions", []):
    key, _, label = action.partition("=")
    actions += [key, label]
  hints = {"desktop-entry": GLib.Variant("s", icon)}
  bus.call_sync(BUS_NAME, BUS_PATH, BUS_NAME, "Notify",
                GLib.Variant("(susssasa{sv}i)", (app, 0, icon, n["summary"], body, actions, hints, -1)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 5000, None)


def main():
  bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
  # Off screen, not forgotten: history keeps what was there.
  subprocess.run(["quattro-shell", "-q", "notifications", "dismissAll"], check=False)
  time.sleep(0.4)
  try:
    for n in NOTIFICATIONS:
      send(bus, n)
      time.sleep(n.get("gap", GAP))
  except KeyboardInterrupt:
    pass


if __name__ == "__main__":
  main()
