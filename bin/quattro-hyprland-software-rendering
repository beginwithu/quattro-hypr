#!/bin/bash

# quattro:summary=Turn off animations, blur and shadows for a Hyprland session that renders on the CPU
# quattro:hidden=true

set -uo pipefail

if [[ -z ${XDG_RUNTIME_DIR:-} || -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  exit 0
fi

marker="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/quattro-software-rendering"
if [[ -e $marker ]]; then
  exit 0
fi

probe_software_rendering() {
  python3 -B - <<'PY'
import ctypes, glob, os, re, sys

SOFTWARE_RENDERERS = ("llvmpipe", "softpipe", "software rasterizer")
BUILTIN_CONNECTORS = ("eDP", "LVDS", "DSI")
EGL_PLATFORM_GBM_KHR = 0x31D7
EGL_OPENGL_ES_API = 0x30A0
EGL_CONTEXT_MAJOR_VERSION = 0x3098
EGL_NONE = 0x3038
GL_RENDERER = 0x1F01

def is_software(renderer):
    lowered = renderer.lower()
    return any(name in lowered for name in SOFTWARE_RENDERERS)

def node_number(node):
    digits = re.search(r"(\d+)$", os.path.basename(node))
    return int(digits.group(1)) if digits else sys.maxsize

def builtin_panels(card, sysfs):
    count = 0
    for status in glob.glob(f"{sysfs}/{os.path.basename(card)}-*/status"):
        connector = os.path.basename(os.path.dirname(status)).split("-")[1]
        if connector not in BUILTIN_CONNECTORS:
            continue
        try:
            with open(status) as state:
                if state.read().strip() == "connected":
                    count += 1
        except OSError:
            continue
    return count

def primary_card(cards, sysfs, environ):
    configured = [entry for entry in environ.get("AQ_DRM_DEVICES", "").split(":") if entry]
    for entry in configured:
        for card in cards:
            if os.path.realpath(card) == os.path.realpath(entry):
                return card
    panels, panel_card = 0, None
    for card in cards:
        count = builtin_panels(card, sysfs)
        if count > panels:
            panels, panel_card = count, card
    if panel_card:
        return panel_card
    for card in cards:
        try:
            with open(f"{sysfs}/{os.path.basename(card)}/device/boot_vga") as boot_vga:
                if boot_vga.read().strip() == "1":
                    return card
        except OSError:
            continue
    return None

def render_node_of(card, sysfs):
    try:
        entries = os.listdir(f"{sysfs}/{os.path.basename(card)}/device/drm")
    except OSError:
        return None
    render_nodes = sorted((entry for entry in entries if entry.startswith("renderD")), key=node_number)
    return f"/dev/dri/{render_nodes[0]}" if render_nodes else None

def pick_node(nodes, sysfs="/sys/class/drm", environ=os.environ):
    render_nodes = sorted((node for node in nodes if os.path.basename(node).startswith("renderD")), key=node_number)
    cards = sorted((node for node in nodes if os.path.basename(node).startswith("card")), key=node_number)
    primary = primary_card(cards, sysfs, environ)
    if primary:
        primary_render = render_node_of(primary, sysfs)
        if primary_render in render_nodes:
            return primary_render
    if render_nodes:
        return render_nodes[0]
    if primary:
        return primary
    return cards[0] if cards else None

def compositor_nodes():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not runtime or not signature:
        return None
    try:
        with open(f"{runtime}/hypr/{signature}/hyprland.lock") as lock:
            pid = int(lock.readline())
    except (OSError, ValueError):
        return []
    nodes = set()
    try:
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return []
    for fd in fds:
        try:
            target = os.readlink(f"/proc/{pid}/fd/{fd}")
        except OSError:
            continue
        if target.startswith("/dev/dri/"):
            nodes.add(target)
    return list(nodes)

def gl_renderer(node):
    egl = ctypes.CDLL("libEGL.so.1")
    gbm = ctypes.CDLL("libgbm.so.1")
    gles = ctypes.CDLL("libGLESv2.so.2")
    gbm.gbm_create_device.restype = ctypes.c_void_p
    gbm.gbm_create_device.argtypes = [ctypes.c_int]
    gbm.gbm_device_destroy.argtypes = [ctypes.c_void_p]
    egl.eglGetPlatformDisplay.restype = ctypes.c_void_p
    egl.eglGetPlatformDisplay.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
    egl.eglInitialize.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
    egl.eglBindAPI.argtypes = [ctypes.c_uint]
    egl.eglCreateContext.restype = ctypes.c_void_p
    egl.eglCreateContext.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    egl.eglMakeCurrent.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
    egl.eglDestroyContext.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
    egl.eglTerminate.argtypes = [ctypes.c_void_p]
    gles.glGetString.restype = ctypes.c_char_p
    gles.glGetString.argtypes = [ctypes.c_uint]
    fd = os.open(node, os.O_RDWR | os.O_CLOEXEC)
    saved_stderr = os.dup(2)
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, 2)
    os.close(devnull)
    device = display = context = None
    try:
        device = gbm.gbm_create_device(fd)
        if not device:
            return None
        display = egl.eglGetPlatformDisplay(EGL_PLATFORM_GBM_KHR, device, None)
        if not display or not egl.eglInitialize(display, None, None):
            return None
        if not egl.eglBindAPI(EGL_OPENGL_ES_API):
            return None
        attributes = (ctypes.c_int * 3)(EGL_CONTEXT_MAJOR_VERSION, 2, EGL_NONE)
        context = egl.eglCreateContext(display, None, None, attributes)
        if not context or not egl.eglMakeCurrent(display, None, None, context):
            return None
        renderer = gles.glGetString(GL_RENDERER)
        return renderer.decode(errors="replace") if renderer else None
    finally:
        if display:
            egl.eglMakeCurrent(display, None, None, None)
            if context:
                egl.eglDestroyContext(display, context)
            egl.eglTerminate(display)
        if device:
            gbm.gbm_device_destroy(device)
        os.close(fd)
        os.dup2(saved_stderr, 2)
        os.close(saved_stderr)

nodes = compositor_nodes()
if nodes is None:
    nodes = glob.glob("/dev/dri/*")
node = pick_node(nodes)
if not node:
    sys.exit(2)
try:
    renderer = gl_renderer(node)
except (OSError, AttributeError):
    renderer = None
if not renderer:
    sys.exit(2)
print(renderer)
sys.exit(0 if is_software(renderer) else 1)
PY
}

wait_for_notifications() {
  local timeout=${1:-15}
  local attempts=$((timeout * 10))
  while (( attempts > 0 )); do
    if quattro-shell notifications ping >/dev/null 2>&1 &&
      busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications GetServerInformation >/dev/null 2>&1; then
      return 0
    fi
    attempts=$((attempts - 1))
    sleep 0.1
  done
  return 1
}

status=2
renderer=""
for (( attempt = 1; attempt <= 20; attempt++ )); do
  renderer=$(probe_software_rendering 2>/dev/null)
  status=$?
  if (( status != 2 )); then
    break
  fi
  sleep 0.5
done

if (( status == 0 )); then
  printf '%s\n' "$renderer" >"$marker"

  if quattro-toggle --enabled animations-without-gpu; then
    logger -t quattro "Hyprland renders on the CPU ($renderer); animations stay on, as Appearance turned them back on."
  else
    hyprctl reload >/dev/null

    kept=()
    unread=0
    for option in animations:enabled=animations decoration:blur:enabled=blur decoration:shadow:enabled=shadows; do
      case $(hyprctl -j getoption "${option%=*}" 2>/dev/null | jq -r '.bool' 2>/dev/null) in
        false) ;;
        true) kept+=("${option#*=}") ;;
        *) unread=1 ;;
      esac
    done

    if (( unread )); then
      logger -t quattro -p user.debug "Hyprland renders on the CPU ($renderer), but its animations, blur or shadows setting couldn't be read after the reload."
    elif (( ${#kept[@]} == 0 )); then
      logger -t quattro "Hyprland renders on the CPU ($renderer), so animations, blur and shadows are off for this session."
      noticed="$HOME/.local/state/quattro/software-rendering-noticed"
      if [[ ! -e $noticed ]] && ! quattro-hyprland-toggle --enabled no-animations; then
        if wait_for_notifications 15; then
          quattro-notification-send --app-name "Software Rendering" -g 󰘚 -u normal -t 30000 "$(quattro-i18n animations.softwareRendering)" "$(quattro-i18n animations.softwareRenderingBody)"
          mkdir -p "${noticed%/*}"
          touch "$noticed"
        else
          logger -t quattro -p user.debug "No notification server after 15s, so the software-rendering notice went unshown."
        fi
      fi
    else
      kept_list=${kept[*]}
      logger -t quattro "Hyprland renders on the CPU ($renderer); keeping the ${kept_list// / and } ~/.config/hypr turns on."
    fi
  fi
elif (( status == 2 )); then
  logger -t quattro -p user.debug "Couldn't read Hyprland's GL renderer after $(( attempt - 1 )) tries, so its animations stay as configured."
fi
