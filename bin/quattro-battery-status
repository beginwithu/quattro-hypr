#!/bin/bash

# quattro:summary=Returns a formatted battery status string with percentage and power draw/charge.
# quattro:args=[--shell]


set -uo pipefail

shell_output=false
power_supply_path="${QUATTRO_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

case "${1:-}" in
  "")
    ;;
  --shell)
    shell_output=true
    ;;
  *)
    echo "Usage: quattro-battery-status [--shell]" >&2
    exit 2
    ;;
esac

# Durations and the status line read in the Quattro language; the --shell
# time feeds the power panel, which shows it as-is.
# The power reading is joined with no-break spaces so a longer language wraps
# the line between its parts rather than inside "13.1W / 53Wh".
format_duration() {
  local minutes=$1
  if [[ -z $minutes ]] || (( minutes <= 0 )); then
    return
  elif (( minutes < 60 )); then
    quattro-i18n battery.durationMinutes "$minutes"
  elif (( minutes % 60 == 0 )); then
    quattro-i18n battery.durationHours "$(( minutes / 60 ))"
  else
    quattro-i18n battery.durationHoursMinutes "$(( minutes / 60 ))" "$(( minutes % 60 ))"
  fi
}

# UPower names the device after the sysfs entry, and only some kernels call
# that BAT*: Apple Silicon reports battery_macsmc_battery. Match on the class,
# then take the first one that powers the machine: a wireless mouse or keyboard
# is a battery_ device too, and UPower marks it "power supply: no".
battery=""
battery_info=""
while read -r candidate; do
  [[ -n $candidate && $candidate == */battery_* ]] || continue
  candidate_info=$(upower -i "$candidate" 2>/dev/null) || continue
  if [[ $candidate_info =~ (^|$'\n')[[:space:]]*power\ supply:[[:space:]]+yes($|$'\n') ]]; then
    battery=$candidate
    battery_info=$candidate_info
    break
  fi
done < <(upower -e 2>/dev/null)
[[ -z $battery ]] && exit 0

# Single awk pass over UPower output instead of 10 separate awk invocations.
IFS=$'\t' read -r percentage capacity energy energy_full upower_hours power_rate_raw native_path state threshold_start threshold_end < <(
  awk '
    /^[[:space:]]*percentage:/ && percentage == "" { percentage = int($2); next }
    /^[[:space:]]*energy-full:/ && energy_full == "" { energy_full = $2; capacity = sprintf("%d", $2); next }
    /^[[:space:]]*energy:/ && energy == "" { energy = $2; next }
    /^[[:space:]]*time to (empty|full):/ && upower_hours == "" { upower_hours = ($5 ~ /^minute/ ? $4 / 60 : $4); next }
    /^[[:space:]]*energy-rate:/ && power_rate_raw == "" { power_rate_raw = $2; next }
    /^[[:space:]]*native-path:/ && native_path == "" { native_path = $2; next }
    /^[[:space:]]*state:/ && state == "" { state = $2; next }
    /^[[:space:]]*charge-start-threshold:/ && threshold_start == "" { gsub(/%/, "", $2); threshold_start = int($2); next }
    /^[[:space:]]*charge-end-threshold:/ && threshold_end == "" { gsub(/%/, "", $2); threshold_end = int($2); next }
    END {
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
        percentage, capacity, energy, energy_full, upower_hours, power_rate_raw, native_path, state, threshold_start, threshold_end
    }
  ' <<<"$battery_info"
)
battery_path="$power_supply_path/$native_path"

# A sysfs reading as a number, or nothing. Firmware that doesn't know the
# present rate leaves current_now in place but fails every read of it (ENODEV),
# so a readable file is no promise of a value.
read_sysfs_number() {
  local value
  { value=$(<"$1"); } 2>/dev/null || return 1
  [[ $value =~ ^-?[0-9]+$ ]] || return 1
  echo "$value"
}

microwatts=""
microamps=""
microvolts=""
if microwatts=$(read_sysfs_number "$battery_path/power_now"); then
  :
elif microamps=$(read_sysfs_number "$battery_path/current_now") && microvolts=$(read_sysfs_number "$battery_path/voltage_now"); then
  :
else
  microamps=""
  microvolts=""
fi

# Read the thresholds from the battery UPower resolved rather than a BAT* glob,
# which misses every battery with another name.
[[ -n $threshold_end || ! -r $battery_path/charge_control_end_threshold ]] || threshold_end=$(<"$battery_path/charge_control_end_threshold")
[[ -n $threshold_start || ! -r $battery_path/charge_control_start_threshold ]] || threshold_start=$(<"$battery_path/charge_control_start_threshold")
# The time to full counts to this battery's own limit, never another one's.
charge_limit=${threshold_end:-100}
if [[ -z $threshold_end ]]; then
  for _f in "$power_supply_path"/BAT*/charge_control_end_threshold; do
    [[ -r $_f ]] && { threshold_end=$(<"$_f"); break; }
  done
fi
if [[ -z $threshold_start ]]; then
  for _f in "$power_supply_path"/BAT*/charge_control_start_threshold; do
    [[ -r $_f ]] && { threshold_start=$(<"$_f"); break; }
  done
fi

# Single awk pass for power_rate, minutes_remaining, and charge_idle (replaces 4 awk calls).
IFS=$'\t' read -r power_rate minutes_remaining charge_idle < <(
  awk \
    -v raw="${power_rate_raw:-0}" \
    -v uw="$microwatts" -v ua="$microamps" -v uv="$microvolts" \
    -v energy="$energy" -v full="$energy_full" \
    -v state="$state" -v limit="$charge_limit" -v fallback="$upower_hours" 'BEGIN {
    if (uw != "") rate = uw / 1000000
    else if (ua != "" && uv != "") rate = ua * uv / 1000000000000
    else rate = raw + 0
    if (rate < 0) rate = -rate

    rounded = sprintf("%.1f", rate)
    sub(/\.0$/, "", rounded)

    idle = (rate <= 0.2) ? "true" : "false"

    mins = ""
    if (energy != "" && full != "" && rate > 0.2) {
      hours = state == "charging" ? (full * limit / 100 - energy) / rate : energy / rate
    } else {
      hours = fallback
    }
    if (hours != "" && hours > 0) {
      mins = sprintf("%d", int(hours * 60 + 0.5))
    }

    printf "%s\t%s\t%s\n", rounded, mins, idle
  }'
)
time_remaining=$(format_duration "$minutes_remaining")

ac_online=false
for supply in "$power_supply_path"/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Mains" ]] || continue
  [[ -r $supply/online ]] || continue

  if [[ $(<"$supply/online") == "1" ]]; then
    ac_online=true
    break
  fi
done

charge_holding=false
if [[ $ac_online == "true" && -n $threshold_end ]]; then
  if [[ $state == "pending-charge" ]]; then
    charge_holding=true
  elif [[ $state == "fully-charged" ]] && (( percentage < 99 )); then
    charge_holding=true
  elif [[ $state == "charging" && $charge_idle == "true" ]] && (( threshold_end < 99 && percentage >= threshold_end )); then
    charge_holding=true
  fi
fi

if [[ $shell_output == "true" ]]; then
  printf 'percentage\t%s\n' "${percentage}%"
  if [[ $charge_holding == "true" ]]; then
    printf 'state\tholding\n'
  else
    printf 'state\t%s\n' "$state"
  fi
  printf 'rate\t%s\n' "${power_rate}W"
  printf 'size\t%s\n' "${capacity}Wh"
  printf 'time\t%s\n' "$time_remaining"

  cycles=""
  [[ ! -r $battery_path/cycle_count ]] || cycles=$(<"$battery_path/cycle_count")
  if [[ -z $cycles ]]; then
    for _f in "$power_supply_path"/BAT*/cycle_count; do
      [[ -r $_f ]] && { cycles=$(<"$_f"); break; }
    done
  fi

  [[ -n $cycles ]] && printf 'cycles\t%s\n' "$cycles"

  if [[ -n $threshold_end ]]; then
    if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
      printf 'threshold\t%s-%s%%\n' "$threshold_start" "$threshold_end"
    else
      printf 'threshold\t%s%%\n' "$threshold_end"
    fi
  fi

  exit 0
fi

# Each part of the line shows only when it has a reading behind it: a full or
# idle battery has no time to count and no draw worth a "0W".
battery_full=false
if [[ $state == "fully-charged" ]]; then
  battery_full=true
elif [[ $ac_online == "true" ]] && (( percentage >= 100 )); then
  # A load bigger than the adapter drains a battery that still reads 100%.
  if [[ $state != "discharging" || $charge_idle == "true" ]]; then
    battery_full=true
  fi
fi

parts=("$(quattro-i18n battery.statusLabel "$percentage")")

if [[ $charge_holding == "true" ]]; then
  if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
    threshold_label="$(quattro-i18n --number "$threshold_start")-$(quattro-i18n --number "$threshold_end")%"
  else
    threshold_label="$(quattro-i18n --number "$threshold_end")%"
  fi

  parts+=("$(quattro-i18n battery.holdingAt "$threshold_label")")
elif [[ $battery_full == "true" ]]; then
  parts+=("$(quattro-i18n battery.fullyCharged)")
elif [[ -n $time_remaining && $state == "charging" ]]; then
  parts+=("$(quattro-i18n battery.toFull "$time_remaining")")
elif [[ -n $time_remaining ]]; then
  parts+=("$(quattro-i18n battery.timeLeft "$time_remaining")")
fi

# The power reading shows its numbers in the language's own way, with an arrow
# for the direction of a live draw.
capacity_reading=""
(( ${capacity:-0} > 0 )) && capacity_reading="$(quattro-i18n --number "$capacity")Wh"
if [[ $charge_holding == "false" && $battery_full == "false" && $charge_idle == "false" ]]; then
  if [[ $state == "charging" ]]; then
    draw=" $(quattro-i18n --number "$power_rate")W"
  else
    draw=" $(quattro-i18n --number "$power_rate")W"
  fi

  if [[ -n $capacity_reading ]]; then
    parts+=("${draw} / ${capacity_reading}")
  else
    parts+=("$draw")
  fi
elif [[ -n $capacity_reading ]]; then
  parts+=("$capacity_reading")
fi

line=${parts[0]}
for part in "${parts[@]:1}"; do
  line+="  ·  $part"
done
echo "$line"
