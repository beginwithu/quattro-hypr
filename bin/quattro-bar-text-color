#!/bin/bash

# quattro:summary=Choose a legible transparent bar text color
# quattro:hidden=true

set -euo pipefail

position=${1:-top}
bar_size=${2:-}
text_color=${3:-}
background_color=${4:-}
background_path=""
screen_size=""

shift 4 2>/dev/null || true
while (($# > 0)); do
  case "$1" in
  --background)
    (( $# >= 2 )) || { echo "quattro-bar-text-color: $1 requires a value" >&2; exit 1; }
    background_path="$2"
    shift 2
    ;;
  --screen)
    (( $# >= 2 )) || { echo "quattro-bar-text-color: $1 requires a value" >&2; exit 1; }
    screen_size="$2"
    shift 2
    ;;
  *)
    shift
    ;;
  esac
done

valid_hex() {
  [[ $1 =~ ^#[0-9A-Fa-f]{6}$ ]]
}

fallback() {
  printf '%s\n' "$text_color"
  exit 0
}

valid_hex "$text_color" || fallback
valid_hex "$background_color" || fallback
[[ $position =~ ^(top|bottom|left|right)$ ]] || fallback
[[ $bar_size =~ ^[0-9]+$ ]] || fallback
quattro-cmd present magick || fallback

if [[ -z $background_path ]]; then
  background_path=$(readlink -f "$HOME/.local/state/quattro/current/background" 2>/dev/null || true)
fi
[[ -f $background_path ]] || fallback

if [[ -z $screen_size ]]; then
  if quattro-cmd present hyprctl && quattro-cmd present jq; then
    screen_size=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0] | "\(.width)x\(.height)"' 2>/dev/null || true)
  fi
fi
[[ $screen_size =~ ^([0-9]+)x([0-9]+)$ ]] || fallback

screen_width=${BASH_REMATCH[1]}
screen_height=${BASH_REMATCH[2]}
((screen_width > 0 && screen_height > 0 && bar_size > 0)) || fallback

# Only the bar strip's mean colour is needed, so sample on a canvas no wider than
# 1920 px; a 6K or 8K screen would otherwise add a full-size intermediate image.
if ((screen_width > 1920)); then
  screen_height=$(((screen_height * 1920 + screen_width - 1) / screen_width))
  bar_size=$(((bar_size * 1920 + screen_width - 1) / screen_width))
  screen_width=1920
fi

case "$position" in
top)
  crop="${screen_width}x${bar_size}+0+0"
  ;;
bottom)
  crop_y=$((screen_height - bar_size))
  ((crop_y >= 0)) || fallback
  crop="${screen_width}x${bar_size}+0+${crop_y}"
  ;;
left)
  crop="${bar_size}x${screen_height}+0+0"
  ;;
right)
  crop_x=$((screen_width - bar_size))
  ((crop_x >= 0)) || fallback
  crop="${bar_size}x${screen_height}+${crop_x}+0"
  ;;
esac

# Sample the first frame only. Without the selector a video background makes
# ImageMagick decode the whole file and emit one value per frame, and the match
# below then fails into the fallback colour. Let JPEG decode at about canvas size
# and box-scale to the canvas, so a 6K or 8K photo fits the limit without a
# second full-size resize buffer. Box scaling still averages every source pixel;
# point sampling would alias on fine stripes and pick the wrong text color. Do
# not let an oversized image spill its pixel cache into a memory map or /tmp (a
# tmpfs on Quattro); fall back to the configured text color when the bounded
# sample cannot finish cheaply.
pixel=$(MAGICK_MEMORY_LIMIT=512MiB \
  MAGICK_MAP_LIMIT=0 \
  MAGICK_DISK_LIMIT=0 \
  MAGICK_TIME_LIMIT=5 \
  MAGICK_THREAD_LIMIT=2 \
  timeout --kill-after=1s 5s magick -define jpeg:size="${screen_width}x${screen_height}" "$background_path[0]" -auto-orient \
  -scale "${screen_width}x${screen_height}^" \
  -gravity center -extent "${screen_width}x${screen_height}" \
  -gravity NorthWest -crop "$crop" +repage \
  -resize '1x1!' -format '%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]' info:- 2>/dev/null || true)
[[ $pixel =~ ^([0-9]+),([0-9]+),([0-9]+)$ ]] || fallback

sample=$(printf '#%02x%02x%02x' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
awk -v fg="$text_color" -v bg="$background_color" -v sample="$sample" '
  function hex_val(c) { return index("0123456789abcdef", tolower(c)) - 1 }
  function channel(hex, start) {
    return (hex_val(substr(hex, start, 1)) * 16 + hex_val(substr(hex, start + 1, 1))) / 255
  }
  function linear(c) {
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4
  }
  function luminance(hex) {
    return 0.2126 * linear(channel(hex, 2)) + 0.7152 * linear(channel(hex, 4)) + 0.0722 * linear(channel(hex, 6))
  }
  function ratio(l1, l2) {
    return l1 >= l2 ? (l1 + 0.05) / (l2 + 0.05) : (l2 + 0.05) / (l1 + 0.05)
  }
  BEGIN {
    ls = luminance(sample)
    print (ratio(luminance(bg), ls) > ratio(luminance(fg), ls)) ? bg : fg
  }
'
