#!/bin/bash

# quattro:summary=Open the current theme's user background folder

CURRENT_THEME_NAME=$(cat "$HOME/.local/state/quattro/current/theme.name" 2>/dev/null)
if [[ -z $CURRENT_THEME_NAME && -L $HOME/.local/state/quattro/current/theme ]]; then
  CURRENT_THEME_NAME=$(basename "$(readlink "$HOME/.local/state/quattro/current/theme")")
fi
THEME_USER_BACKGROUNDS="$HOME/.config/quattro/backgrounds/${CURRENT_THEME_NAME}"

mkdir -p "$THEME_USER_BACKGROUNDS"
exec quattro-launch-files "$THEME_USER_BACKGROUNDS"
