#!/bin/bash

# quattro:summary=Edit or reset About and screensaver branding
# quattro:group=branding
# quattro:args=<about <text|reset>|about-cpu [name|details]|screensaver <text|reset>>
# quattro:examples=quattro branding about text | quattro branding about reset | quattro branding screensaver text

set -euo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"

about_cpu() {
  local WIDTH=47
  local name="" cores="" freq="" details line
  IFS=$'\t' read -r name cores freq < <(
    fastfetch --logo none --pipe --structure cpu --format json 2>/dev/null | jq -r '
      .[0].result
      | [
          .cpu,
          (if (.coreTypes | length) > 1 then (.coreTypes | map(.count | tostring) | join("+")) else (.cores.online | tostring) end),
          (if .frequency.max > 0 then .frequency.max else .frequency.base end)
        ]
      | @tsv' || true
  ) || true

  [[ -n $name ]] || return 0

  details="($cores)"
  (( ${freq:-0} > 0 )) && details+=" @ $(awk -v mhz="$freq" 'BEGIN { printf "%.2f GHz", mhz / 1000 }')"

  line="$name $details"
  if (( ${#line} <= WIDTH )); then
    [[ ${1:-name} == "name" ]] && echo "$line" || true
  elif [[ ${1:-name} == "name" ]]; then
    echo "$name"
  else
    echo "$details"
  fi
}

cmd="${1:-}"
(( $# > 0 )) && shift || true

case "$cmd" in
  about)
    case "${1:-}" in
      text)
        quattro-launch-editor ~/.config/quattro/branding/about.txt >/dev/null 2>&1 && quattro-launch-about >/dev/null 2>&1
        ;;
      reset)
        cp "$QUATTRO_PATH/logo.txt" ~/.config/quattro/branding/about.txt && quattro-launch-about >/dev/null 2>&1
        ;;
      cpu)
        shift
        about_cpu "$@"
        ;;
      *)
        echo "Usage: quattro-branding about <text|reset|cpu>" >&2
        exit 1
        ;;
    esac
    ;;
  about-cpu)
    about_cpu "$@"
    ;;
  screensaver)
    case "${1:-}" in
      text)
        quattro-launch-editor ~/.config/quattro/branding/screensaver.txt >/dev/null 2>&1 && quattro-launch-screensaver force >/dev/null 2>&1
        ;;
      reset)
        cp "$QUATTRO_PATH/icon.txt" ~/.config/quattro/branding/screensaver.txt && quattro-launch-screensaver force >/dev/null 2>&1
        ;;
      *)
        echo "Usage: quattro-branding screensaver <text|reset>" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Usage: quattro-branding <about <text|reset>|about-cpu [name|details]|screensaver <text|reset>>" >&2
    exit 1
    ;;
esac
