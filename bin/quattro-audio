#!/bin/bash

# quattro:summary=Manage PipeWire/PulseAudio inputs, outputs, sinks, and media sources
# quattro:group=audio
# quattro:args=<input-mute|input-set-default <id> <name>|output-set-default <id> <name>|output-sink [sink]|output-switch|sink-availability [sources]|source-switch [next|previous]>
# quattro:examples=quattro audio output-switch | quattro audio input-mute | quattro audio output-sink

set -euo pipefail

mic_mute_led() {
  if [[ -e /sys/class/leds/platform::micmute/brightness ]]; then
    local value=0
    [[ $1 == "on" ]] && value=1
    brightnessctl --device="platform::micmute" set "$value" >/dev/null 2>&1 || true
  fi
}

audio_input_mute() {
  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null
  if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
    mic_mute_led on
    quattro-osd -i microphone-muted -m "$(quattro-i18n audio.micMuted)"
  else
    mic_mute_led off
    quattro-osd -i microphone -m "$(quattro-i18n audio.micOn)"
  fi
}

audio_input_set_default() {
  local node_id=${1:-}
  local source_name=${2:-}
  if [[ -z $node_id || -z $source_name ]]; then
    echo "Usage: quattro-audio input-set-default <node-id> <source-name>" >&2
    exit 1
  fi

  wpctl set-default "$node_id" 2>/dev/null || true
  pactl set-default-source "$source_name" 2>/dev/null || true

  LC_ALL=C pactl list source-outputs 2>/dev/null | awk '
    /^Source Output #/ { if (id != "" && !filter) print id; id = substr($3, 2); filter = 0 }
    /^[[:space:]]*node\.link-group = / { filter = 1 }
    END { if (id != "" && !filter) print id }' | while read -r output; do
    [[ -n $output ]] && pactl move-source-output "$output" "$source_name" 2>/dev/null || true
  done
}

audio_output_set_default() {
  local node_id=${1:-}
  local sink_name=${2:-}
  if [[ -z $node_id || -z $sink_name ]]; then
    echo "Usage: quattro-audio output-set-default <node-id> <sink-name>" >&2
    exit 1
  fi

  timeout 2 wpctl set-default "$node_id" 2>/dev/null || true
  timeout 2 pactl set-default-sink "$sink_name" 2>/dev/null || true

  LC_ALL=C timeout 2 pactl list sink-inputs 2>/dev/null | awk '
    /^Sink Input #/ {id = substr($3, 2)}
    /application\.name = / {
      app = $0
      sub(/.*application\.name = "/, "", app)
      sub(/"$/, "", app)
      if (app != "EasyEffects") print id
    }' | while read -r input; do
    [[ -n $input ]] && timeout 2 pactl move-sink-input "$input" "$sink_name" 2>/dev/null || true
  done
}

audio_output_sink() {
  local sink="${1:-$(pactl get-default-sink 2>/dev/null || true)}"

  if [[ -z $sink || $sink == alsa_output.* ]]; then
    printf '%s\n' "$sink"
    return 0
  fi

  local downstream name linked configured
  downstream="$(LC_ALL=C pactl list sink-inputs 2>/dev/null |
    awk -v virt="$sink" '
      BEGIN {
        output = virt
        sub(/^effect_input\./, "effect_output.", output)
      }
      /^Sink Input #/ {target = ""}
      /^[[:space:]]*Sink:/ {target = $2}
      /node\.name = / {
        name = $0
        sub(/.*node\.name = "/, "", name)
        sub(/"$/, "", name)
        if (target != "" && (name == output || (output == virt && index(name, virt) == 1))) {selected = target; exit}
        if (target != "" && fallback == "" && index(name, virt) == 1) fallback = target
      }
      /application\.name = "EasyEffects"/ {
        if (virt == "easyeffects_sink" && target != "") {selected = target; exit}
      }
      END {
        if (selected != "") print selected
        else if (fallback != "") print fallback
      }')" || true

  if [[ -n $downstream ]]; then
    name="$(pactl list sinks short 2>/dev/null |
      awk -v id="$downstream" '$1 == id {print $2; exit}')" || true
    if [[ -n $name ]]; then
      printf '%s\n' "$name"
      return 0
    fi
  fi

  if [[ $sink == "easyeffects_sink" ]]; then
    linked="$(pw-link -l 2>/dev/null |
      awk '
        /^[^ ]/ {src = $0}
        /^[[:space:]]*\|->/ {
          if (src ~ /^ee_/ && $2 ~ /^(alsa|bluez)_output\..*:playback_/) {
            sub(/:playback_.*$/, "", $2); print $2; exit
          }
        }')" || true

    if [[ -z $linked ]]; then
      configured="$(sed -n 's/^outputDevice=//p' \
        "${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc" 2>/dev/null || true)"
      if [[ -n $configured ]] && pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -qxF -- "$configured"; then
        linked="$configured"
      fi
    fi

    if [[ -n $linked ]]; then
      printf '%s\n' "$linked"
      return 0
    fi
  fi

  printf '%s\n' "$sink"
}

audio_output_switch() {
  local sinks sinks_count current_sink_name current_sink_index next_sink_index next_sink
  local next_sink_name next_sink_description next_sink_effective next_sink_volume next_sink_is_muted icon_state

  sinks=$(LC_ALL=C timeout 2 pactl -f json list sinks |
    jq '[.[] | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))]')
  sinks_count=$(jq 'length' <<<"$sinks")

  if (( sinks_count == 0 )); then
    quattro-osd -m "$(quattro-i18n audio.noDevices)"
    exit 1
  fi

  current_sink_name=$(timeout 2 pactl get-default-sink)
  current_sink_index=$(jq -r --arg name "$current_sink_name" 'map(.name) | index($name)' <<<"$sinks")

  if [[ $current_sink_index != "null" ]]; then
    next_sink_index=$(((current_sink_index + 1) % sinks_count))
  else
    next_sink_index=0
  fi

  next_sink=$(jq -c ".[$next_sink_index]" <<<"$sinks")
  next_sink_name=$(jq -r '.name' <<<"$next_sink")
  next_sink_description=$(jq -r '.description // .properties."device.description" // .name' <<<"$next_sink")
  next_sink_effective=$(audio_output_sink "$next_sink_name")
  next_sink_volume=$(LC_ALL=C timeout 2 pactl get-sink-volume "$next_sink_effective" 2>/dev/null |
    awk 'NR == 1 {for (i = 1; i <= NF; i++) if ($i ~ /%$/) {sub("%", "", $i); print $i; exit}}' || true)
  [[ -n $next_sink_volume ]] || next_sink_volume=$(jq -r '.volume | to_entries[0].value.value_percent | sub("%"; "") | tonumber' <<<"$next_sink")

  if [[ $(LC_ALL=C timeout 2 pactl get-sink-mute "$next_sink_effective" 2>/dev/null || true) == *yes ]]; then
    next_sink_is_muted=true
  else
    next_sink_is_muted=false
  fi

  if [[ $next_sink_is_muted == "true" ]] || (( next_sink_volume == 0 )); then
    icon_state="muted"
  elif (( next_sink_volume <= 33 )); then
    icon_state="low"
  elif (( next_sink_volume <= 66 )); then
    icon_state="medium"
  else
    icon_state="high"
  fi

  if [[ $next_sink_name != "$current_sink_name" ]]; then
    audio_output_set_default "$(jq -r '.index' <<<"$next_sink")" "$next_sink_name"
  fi

  quattro-osd -i "volume-${icon_state}" -m "$next_sink_description"
}

audio_sink_availability() {
  local kind=sinks header="Sink #"
  if [[ ${1:-} == "sources" ]]; then
    kind=sources
    header="Source #"
  fi

  LC_ALL=C pactl list "$kind" 2>/dev/null | awk -v header="$header" '
    function emit_sink() {
      if (name == "") return
      print name "\t" ((port_count == 0 || available) ? 1 : 0)
    }
    index($0, header) == 1 {
      emit_sink()
      name = ""
      in_ports = 0
      port_count = 0
      available = 0
      next
    }
    /^[[:space:]]*Name:/ { name = $2; next }
    /^[[:space:]]*Ports:$/ { in_ports = 1; next }
    in_ports && /^\tActive Port:/ { in_ports = 0; next }
    in_ports && /^\t\t/ {
      port_count++
      if ($0 !~ /not available/) available = 1
      next
    }
    END { emit_sink() }
  '
}

audio_source_switch() {
  case "${1:-next}" in
    next) quattro-shell media sourceSwitch ;;
    previous) quattro-shell media sourceSwitchPrevious ;;
    *)
      echo "Usage: quattro-audio source-switch [next|previous]" >&2
      exit 1
      ;;
  esac
}

cmd="${1:-}"
(( $# > 0 )) && shift || true

case "$cmd" in
  input-mute) audio_input_mute ;;
  input-set-default) audio_input_set_default "$@" ;;
  output-set-default) audio_output_set_default "$@" ;;
  output-sink) audio_output_sink "$@" ;;
  output-switch) audio_output_switch ;;
  sink-availability) audio_sink_availability "$@" ;;
  source-switch) audio_source_switch "$@" ;;
  *)
    echo "Usage: quattro-audio <input-mute|input-set-default|output-set-default|output-sink|output-switch|sink-availability|source-switch> [args...]" >&2
    exit 1
    ;;
esac
