#!/bin/bash

# quattro:summary=Watch Hyprland monitor events and recover monitor toggles when a monitor is removed
# quattro:hidden=true

set -uo pipefail

SOCKET="${XDG_RUNTIME_DIR:-}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/quattro-monitor-clamshell.lock"
MODELESS_LOCK="${XDG_RUNTIME_DIR:-/tmp}/quattro-monitor-modeless.lock"
RELOAD_GUARD_STATE_DIR="${QUATTRO_HYPRLAND_RELOAD_GUARD_STATE_DIR:-/run/quattro/hyprland-reload-guard}"

monitor_modeless() {
  local monitors state
  monitors=$(hyprctl monitors all -j 2>/dev/null) || return 2
  state=$(jq 'if any(.[]; .disabled != true and (.width == 0 or .height == 0)) then 0 else 1 end' <<<"$monitors" 2>/dev/null || echo 2)
  case "$state" in
    0 | 1) return "$state" ;;
    *) return 2 ;;
  esac
}

reload_guard_paused() {
  compgen -G "$RELOAD_GUARD_STATE_DIR/*" >/dev/null
}

sync_clamshell() {
  (
    flock -n 9 || exit 0
    quattro-hyprland-monitor-clamshell
    quattro-system-lid-inhibit
  ) 9>"$LOCK"
}

sync_clamshell_after_monitor_change() {
  sync_clamshell

  (
    for delay in 1 3 7; do
      sleep "$delay"
      sync_clamshell
    done
  ) &
}

recover_modeless() {
  (
    flock -w 1 9 || exit 0

    local delay=3 state reloaded unanswered=0

    while true; do
      monitor_modeless
      state=$?

      (( state == 1 )) && break
      (( state == 2 )) && (( ++unanswered > 20 )) && break
      (( state == 0 )) && unanswered=0

      reloaded=0
      if (( state == 0 )) && ! reload_guard_paused; then
        quattro-restart hyprctl
        reloaded=1
      fi

      sleep "$delay"
      (( reloaded )) && (( delay = delay * 2 > 60 ? 60 : delay * 2 ))
    done
  ) 9>"$MODELESS_LOCK" &
}

poll_clamshell_state() {
  while true; do
    sleep 2
    sync_clamshell
  done
}

poll_pid=""
sync_poll_state() {
  if quattro-hw laptop && quattro-hyprland-monitor external-active; then
    if [[ -z $poll_pid ]] || ! kill -0 "$poll_pid" 2>/dev/null; then
      poll_clamshell_state &
      poll_pid=$!
    fi
  elif [[ -n $poll_pid ]]; then
    kill "$poll_pid" 2>/dev/null || true
    poll_pid=""
  fi
}

sync_clamshell_after_monitor_change
sync_poll_state
recover_modeless

while read -r event; do
  case "$event" in
    monitoradded\>\>*|monitoraddedv2\>\>*)
      sync_clamshell_after_monitor_change
      sync_poll_state
      recover_modeless
      ;;
    monitorremoved\>\>*|monitorremovedv2\>\>*)
      sync_clamshell_after_monitor_change
      sync_poll_state
      recover_modeless
      ;;
    configreloaded\>\>*)
      recover_modeless
      ;;
  esac
done < <(socat -U - "UNIX-CONNECT:$SOCKET")
