#!/bin/bash

# quattro:summary=Select the keyboard layouts available for switching

set -euo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
export QUATTRO_PATH

exec /usr/bin/python3 -B "$QUATTRO_PATH/default/input-methods/typing_setup.py" keyboard
