#!/bin/bash

# quattro:summary=Set a new password for an encrypted drive
# quattro:requires-sudo=true

set -euo pipefail
# Passwords live in variables; never trace them.
set +x

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/quattro"
disk_lock="$state_dir/drive-password.disk.lock"

drive_info() {
  local drive="$1" root_drive size number vendor model label="" display part_summary
  root_drive=$(lsblk -no PKNAME "$drive" 2>/dev/null | tail -n1 || true)
  if [[ -n $root_drive ]]; then
    root_drive="/dev/$root_drive"
  else
    root_drive="$drive"
  fi

  size=$(lsblk -dno SIZE "$drive" 2>/dev/null | tr -d '[:space:]' || true)
  if [[ $size =~ ^([0-9]+([.,][0-9]+)?)([A-Za-z]*)$ ]] && number=$(quattro-i18n --number "${BASH_REMATCH[1]/,/.}" 2>/dev/null); then
    size="$number${BASH_REMATCH[3]}"
  fi

  vendor=$(lsblk -dno VENDOR "$root_drive" 2>/dev/null | sed 's/ *$//' || true)
  model=$(lsblk -dno MODEL "$root_drive" 2>/dev/null | sed 's/ *$//' || true)

  if [[ -n $vendor && -n $model ]]; then
    if [[ $model == *$vendor* ]]; then label="$model"; else label="$vendor $model"; fi
  elif [[ -n $model ]]; then
    label="$model"
  elif [[ -n $vendor ]]; then
    label="$vendor"
  fi

  display="$drive"
  [[ -n $size ]] && display="$display ($size)"
  [[ -n $label ]] && display="$display - $label"

  part_summary=$(lsblk -nro TYPE,NAME,FSTYPE,MOUNTPOINT "$root_drive" 2>/dev/null |
    awk '$1=="part" { printf "%s%s%s", s, ($3==""?"unknown":$3), ($4==""?"":"("$4")"); s=", " }' || true)
  [[ -n $part_summary ]] && display+=" [$part_summary]"

  echo "$display"
}

drive_select() {
  local drives="${1:-}" drive drives_with_info="" selected_drive
  while IFS= read -r drive; do
    [[ -n $drive ]] || continue
    drives_with_info+="$(drive_info "$drive")"$'\n'
  done <<<"$drives"

  selected_drive="$(printf "%s" "$drives_with_info" | gum choose --header "$(quattro-i18n drive.select)")" || return 1
  printf "%s\n" "$selected_drive" | awk '{print $1}'
}

luks_drives() {
  lsblk -nrpo NAME,FSTYPE | awk '$2 == "crypto_LUKS" && !seen[$1]++ { print $1 }'
}

drive_key_slot() {
  local drive=$1 password=$2 out status=0
  out=$(printf '%s' "$password" | sudo flock "$disk_lock" env LC_ALL=C cryptsetup open --test-passphrase --verbose --token-type passphrase-only --key-file - "$drive" 2>&1) || status=$?
  (( status == 0 )) || return "$status"
  grep -o 'Key slot [0-9]* unlocked' <<<"$out" | grep -o '[0-9]*' | head -1
}

kill_slot() {
  local drive=$1 password=$2 slot=$3
  printf '%s' "$password" | sudo flock "$disk_lock" cryptsetup luksKillSlot -q --key-file - "$drive" "$slot"
}

change_luks_key() {
  local drive=$1 current=$2 new=$3 remains attempt status new_slot
  local -a pbkdf=(--iter-time 2000)

  echo "Changing full-disk encryption password for $drive"
  if sudo flock "$disk_lock" cryptsetup isLuks --type luks2 "$drive"; then
    pbkdf+=(--pbkdf argon2id)
  fi
  printf '%s\n%s' "$current" "$new" |
    sudo flock "$disk_lock" bash -c 'IFS= read -r current; drive=$1; shift; exec cryptsetup luksChangeKey "$@" --key-file <(printf "%s" "$current") "$drive" <(cat)' bash "$drive" "${pbkdf[@]}"

  new_slot=$(drive_key_slot "$drive" "$new") || return
  for (( attempt = 0; attempt < 8; attempt++ )); do
    status=0
    remains=$(drive_key_slot "$drive" "$current") || status=$?
    (( status == 2 )) && return 0
    (( status == 0 )) && [[ $remains != "$new_slot" ]] || return 1
    kill_slot "$drive" "$new" "$remains" || return 1
  done
  return 1
}

mkdir -p "$state_dir" && touch "$disk_lock" && exec {lock_fd}>"$state_dir/drive-password.lock" && flock -n "$lock_fd" ||
  { echo "Another drive password change is running."; exit 1; }

encrypted_drives=$(luks_drives)
if [[ -z $encrypted_drives ]]; then
  echo "No encrypted drives available."
  exit 1
fi

if (( $(wc -l <<<"$encrypted_drives") == 1 )); then
  drive="$encrypted_drives"
else
  drive="$(drive_select "$encrypted_drives" || true)"
fi

if [[ -z $drive ]]; then
  echo "No drive selected."
  exit 0
fi

current=$(gum input --password --header "$(quattro-i18n drive.currentPassword)") || exit 1
status=0
drive_key_slot "$drive" "$current" >/dev/null || status=$?
if (( status == 2 )); then
  echo "That password does not open $drive."
  exit 1
elif (( status != 0 )); then
  echo "Could not check the password against $drive."
  exit 1
fi

new_password=$(gum input --password --header "$(quattro-i18n drive.newPassword)") || exit 1
[[ -n $new_password ]] || { echo "Password cannot be empty."; exit 1; }

confirmation=$(gum input --password --header "$(quattro-i18n drive.confirmNewPassword)") || exit 1
[[ $new_password == "$confirmation" ]] || { echo "Passwords do not match."; exit 1; }
[[ $new_password != "$current" ]] || { echo "The new password is the current one."; exit 1; }

status=0
drive_key_slot "$drive" "$new_password" >/dev/null || status=$?
if (( status == 0 )); then
  echo "That password already opens a key slot on $drive. Choose another."
  exit 1
elif (( status != 2 )); then
  echo "Could not check the password against $drive."
  exit 1
fi

status=0
change_luks_key "$drive" "$current" "$new_password" || status=$?
if (( status == 2 )); then
  echo "The password of $drive did not change."
  exit 1
elif (( status != 0 )); then
  echo "Could not confirm the password change on $drive."
  exit 1
fi
echo "Encryption password updated for $drive."
