#!/bin/bash

# quattro:summary=Apply the current theme color to Chromium, Chrome, Edge, and Brave
# quattro:hidden=true

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
source "$QUATTRO_PATH/default/chromium/browser-policy.sh"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CURRENT_THEME_DIR="$STATE_HOME/quattro/current/theme"
CHROMIUM_THEME="$CURRENT_THEME_DIR/chromium.theme"
THEME_HEX_COLOR=$BROWSER_POLICY_DEFAULT_COLOR

if [[ -f $CHROMIUM_THEME ]]; then
  THEME_HEX_COLOR=$(browser_policy_theme_hex "$(<$CHROMIUM_THEME)")
fi

# Sync the generated Brave Chrome-theme extension so Brave's toolbar, tab bar,
# omnibox, and suggestion dropdown all follow the active Quattro palette on
# launch without triggering Chromium's "Installed theme ... Undo" infobar.
sync_brave_theme_extension() {
  local src="$CURRENT_THEME_DIR/brave-theme.json"
  local dest_dir="$STATE_HOME/quattro/current/brave-theme"
  local dest="$dest_dir/manifest.json"
  local version tmp sum hex r g b

  [[ -f $src ]] || return 0

  if command -v sha256sum >/dev/null 2>&1; then
    read -r sum _ < <(sha256sum "$src")
    version="1.$((16#${sum:0:4})).$((16#${sum:4:4}))"
  else
    hex="${THEME_HEX_COLOR#\#}"
    r=$((16#${hex:0:2}))
    g=$((16#${hex:2:2}))
    b=$((16#${hex:4:2}))
    version="1.${r}.${g}.${b}"
  fi

  mkdir -p "$dest_dir"
  tmp=$(mktemp "$dest_dir/.manifest.XXXXXX") || return 1
  sed "s/\"version\": \"1\.0\"/\"version\": \"$version\"/" "$src" >"$tmp"
  mv -f "$tmp" "$dest"
}

sync_brave_theme_extension || true

if [[ ${1:-} == "--brave-theme-only" ]]; then
  exit 0
fi

# Tests override this with a temporary directory list; production uses the
# fixed trust-root set from browser-policy.sh (excluding Brave, which uses
# the local --load-extension theme synced above).
POLICY_DIRS=("${BROWSER_POLICY_COLOR_DIRS[@]}")
BRAVE_POLICY_DIR=/etc/brave/policies/managed
BRAVE_THEME_DIR=/var/lib/quattro/brave-theme
if [[ -n ${QUATTRO_BROWSER_POLICY_DIRS:-} ]]; then
  POLICY_DIRS=()
  BRAVE_POLICY_DIR=""
  BRAVE_THEME_DIR=""
  while IFS= read -r dir; do
    POLICY_DIRS+=("$dir")
  done <<< "$QUATTRO_BROWSER_POLICY_DIRS"
fi

# A managed color.json is already correct only when it is a regular, root-owned
# file with mode 0644 containing exactly the canonical JSON for the requested
# color.
file_is_canonical() {
  local file=$1
  [[ -f $file && ! -L $file ]] || return 1
  [[ $(<"$file") == "$expected_json" ]] || return 1
  [[ $(stat -c '%U:%G %a' "$file") == "root:root 644" ]]
}

brave_has_stale_policy() {
  [[ -n $BRAVE_POLICY_DIR && -d $BRAVE_POLICY_DIR && ! -L $BRAVE_POLICY_DIR ]] || return 1
  [[ -e $BRAVE_POLICY_DIR/quattro-theme.json || -L $BRAVE_POLICY_DIR/quattro-theme.json ||
     -e $BRAVE_POLICY_DIR/color.json || -L $BRAVE_POLICY_DIR/color.json ||
     -e $BRAVE_THEME_DIR || -L $BRAVE_THEME_DIR ]]
}

# Skip the privileged policy write and browser refreshes entirely when every
# existing managed color.json is already canonical and no legacy Brave theme
# policy files remain.
expected_json='{"BrowserThemeColor": "'$THEME_HEX_COLOR'", "BrowserColorScheme": "device"}'
saw_any=false
all_unchanged=true
refresh_brave=false
for dir in "${POLICY_DIRS[@]}"; do
  [[ -d $dir && ! -L $dir ]] || continue
  saw_any=true

  if ! file_is_canonical "$dir/color.json"; then
    all_unchanged=false
    break
  fi
done
if brave_has_stale_policy; then
  saw_any=true
  all_unchanged=false
  refresh_brave=true
fi

$saw_any && $all_unchanged && exit 0
# On standalone Arch Linux without managed browser policy directories (or in headless mode without root),
# skip policy updates cleanly instead of triggering an unexpected pkexec prompt.
if ! $saw_any && [[ ${QUATTRO_THEME_BROWSER_FORCE:-0} != "1" ]]; then
  exit 0
fi
if (( EUID != 0 )) && [[ ${QUATTRO_THEME_HEADLESS:-0} == "1" || ! -t 0 ]] &&
  ! sudo -n -l -l /usr/bin/quattro-theme-set-browser-policy "${THEME_HEX_COLOR#\#}" 2>/dev/null | grep -q '!authenticate'; then
  exit 0
fi

failed=0
# A script's background job reads /dev/null unless told otherwise, which would
# turn the writer's terminal sudo prompt into a pkexec dialog. Keep stdin.
quattro-theme-set-browser-policy "${THEME_HEX_COLOR#\#}" <&0 &
policy_pid=$!

# While the policy writes, find the running browsers with one process table
# read. A pgrep per browser rescans /proc each time, ~40ms apiece.
declare -A running_names=()
running_args=""
while read -r name args; do
  running_names[$name]=1
  running_args+="$args"$'\n'
done < <(ps -eo comm=,args=)

# Chrome installs as either binary name, so take whichever exists.
chrome=google-chrome-stable
quattro-cmd-present "$chrome" || chrome=google-chrome

browsers_to_refresh=()
for browser in chromium:chromium "chrome:$chrome" msedge:microsoft-edge-stable; do
  [[ -n ${running_names[${browser%%:*}]:-} ]] && quattro-cmd-present "${browser#*:}" && browsers_to_refresh+=("${browser#*:}")
done
if $refresh_brave; then
  [[ -n ${running_names[brave]:-} ]] && quattro-cmd-present brave && browsers_to_refresh+=(brave)
  # Match on the binary path: the running process is named plain "brave", and a
  # bare brave-origin pattern would also match the installer's own terminal.
  [[ $running_args == *"/opt/brave-origin-bin/"* ]] && quattro-cmd-present brave-origin && browsers_to_refresh+=(brave-origin)
fi

wait "$policy_pid" || failed=1

# Refresh each running browser in parallel, so one slow launch doesn't
# serialize the rest.
refresh_pids=()
for command in "${browsers_to_refresh[@]}"; do
  "$command" --refresh-platform-policy --no-startup-window &>/dev/null &
  refresh_pids+=("$!")
done

for pid in "${refresh_pids[@]}"; do
  wait "$pid"
done

exit "$failed"
