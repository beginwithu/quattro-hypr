#!/bin/bash

# quattro:summary=Show the Quattro Quickshell on-screen display
# quattro:args=[-i|--icon <icon>] [-m|--message <text>] [-p|--progress <0-100>] [-d|--duration <ms>]
# quattro:examples=quattro osd -i brightness -p 50 | quattro osd -m "Hello"

set -euo pipefail

icon=""
message=""
progress=""
progress_text=""
max="100"
duration=""

while (($#)); do
  case $1 in
    -i|--icon) (( $# >= 2 )) || { echo "Missing value for $1" >&2; exit 1; }; icon="$2"; shift 2 ;;
    -m|--message) (( $# >= 2 )) || { echo "Missing value for $1" >&2; exit 1; }; message="$2"; shift 2 ;;
    -p|--progress) (( $# >= 2 )) || { echo "Missing value for $1" >&2; exit 1; }; progress="$2"; shift 2 ;;
    -d|--duration) (( $# >= 2 )) || { echo "Missing value for $1" >&2; exit 1; }; duration="$2"; shift 2 ;;
    -h|--help) quattro osd --help; exit 0 ;;
    *) echo "Unknown OSD option: $1" >&2; exit 1 ;;
  esac
done

if [[ -n $progress ]]; then
  # Shown as given, so the number takes the language's digits here.
  lang_file=${QUATTRO_LANGUAGE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/quattro/language}
  if [[ ! -f $lang_file && $progress =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    progress_text="${progress}%"
  else
    progress_text="$(quattro-i18n --number "$progress" 2>/dev/null || printf '%s' "$progress")%"
  fi
fi

if [[ "$icon$message$progress$progress_text$duration" != *[\"\\$'\x01'-$'\x1f']* ]]; then
  printf -v payload '{"icon":"%s","message":"%s","value":"%s","progressText":"%s","max":"%s","duration":"%s"}' \
    "$icon" "$message" "$progress" "$progress_text" "$max" "$duration"
else
  payload=$(jq -cn \
    --arg icon "$icon" \
    --arg message "$message" \
    --arg value "$progress" \
    --arg progressText "$progress_text" \
    --arg max "$max" \
    --arg duration "$duration" \
    '{icon:$icon,message:$message,value:$value,progressText:$progressText,max:$max,duration:$duration}')
fi

exec quattro-shell -q osd show "$payload"
