#!/bin/bash

# quattro:summary=Install a packaged app and launch it once it finishes
# quattro:args=<display-name> <packages> <desktop-id>
# quattro:examples=quattro install and launch Cursor cursor-bin cursor

name="${1-}"
packages="${2-}"
desktop_id="${3-}"

if [[ -z $name || -z $packages || -z $desktop_id ]]; then
  echo "Usage: quattro-install-and-launch <display-name> <packages> <desktop-id>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."
printf -v desktop_id_arg '%q' "$desktop_id"

# Route official repo packages to quattro-pkg-add and AUR-only packages to quattro-pkg-aur-add.
read -r -d '' -a package_list <<<"$packages" || true
repo_pkgs=()
aur_pkgs=()
for pkg in "${package_list[@]}"; do
  if pacman -Si -- "$pkg" >/dev/null 2>&1; then
    repo_pkgs+=("$pkg")
  else
    aur_pkgs+=("$pkg")
  fi
done

install_steps=()
if (( ${#repo_pkgs[@]} > 0 )); then
  printf -v repo_arg '%q ' "${repo_pkgs[@]}"
  install_steps+=("quattro-pkg-add ${repo_arg% }")
fi
if (( ${#aur_pkgs[@]} > 0 )); then
  printf -v aur_arg '%q ' "${aur_pkgs[@]}"
  install_steps+=("quattro-pkg-aur-add ${aur_arg% }")
fi

install_cmd=""
for step in "${install_steps[@]}"; do
  install_cmd+="${install_cmd:+ && }$step"
done

# The subshell keeps & from backgrounding the package installation too.
exec quattro-launch-floating-terminal-with-presentation \
  "echo ${install_message}; ${install_cmd} && (setsid uwsm-app -- gtk-launch ${desktop_id_arg} >/dev/null 2>&1 &)"
