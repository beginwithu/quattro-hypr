#!/bin/bash

# quattro:summary=Launch the default browser as determined by xdg-settings.
# quattro:args=[url]

set -euo pipefail

browser_handoff() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}"
  local profile flags socket reply arg

  case $(type -P "$1" 2>/dev/null || true) in
    /usr/bin/chromium) profile=chromium flags=chromium-flags.conf ;;
    /usr/bin/google-chrome-stable) profile=google-chrome flags=chrome-flags.conf ;;
    /usr/bin/brave) profile=BraveSoftware/Brave-Browser flags=brave-flags.conf ;;
    /usr/bin/brave-origin) profile=BraveSoftware/Brave-Origin flags=brave-origin-flags.conf ;;
    /usr/bin/microsoft-edge-stable) profile=microsoft-edge flags=microsoft-edge-stable-flags.conf ;;
    *) return 1 ;;
  esac
  shift

  if [[ -n ${CHROME_USER_DATA_DIR:-}${CHROME_CONFIG_HOME:-} ]] ||
    cat "/etc/$flags" "$config/$flags" 2>/dev/null | sed 's/#.*//' | tr -s '[:space:]' '\n' |
      grep -vE '^(--(ozone-platform|ozone-platform-hint|password-store|enable-features|load-extension)=.*|--no-default-browser-check|--no-first-run)?$' | grep -q .; then
    return 1
  fi

  for arg in "$@"; do
    [[ $arg == --user-data-dir* ]] && return 1
  done

  socket="$config/$profile/SingletonSocket"
  [[ -S $socket && -O $socket ]] || return 1

  reply=$({
    printf 'START\0%s\0browser' "$PWD"
    printf '\0%s' "$@"
  } | socat -t2 - "UNIX-CONNECT:$socket" 2>/dev/null || true)

  [[ $reply == "ACK" ]]
}

default_browser=$(quattro-cmd default-browser 2>/dev/null || true)

IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
browser_exec=""
if [[ -n $default_browser ]]; then
  for data_dir in "${data_dirs[@]}"; do
    entry="$data_dir/applications/$default_browser"
    [[ -f $entry ]] || continue
    while IFS= read -r _line; do
      if [[ $_line == Exec=* ]]; then
        browser_exec="${_line#Exec=}"
        browser_exec="${browser_exec%% *}"
        break
      fi
    done <"$entry"
    break
  done
fi

if [[ -z $browser_exec ]]; then
  echo "quattro-launch-browser: no default browser found; set one with 'quattro default browser <browser>'" >&2
  quattro-notification-send -u critical -g 󰖟 "$(quattro-i18n browser.notFound)" "$(quattro-i18n browser.notFoundHint)"
  exit 1
fi

private_flag="--private"
has_private=0
for arg in "$@"; do
  if [[ $arg == "--private" ]]; then
    has_private=1
    break
  fi
done
if (( has_private )); then
  if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
    private_flag="--private-window"
  elif [[ $browser_exec =~ edge ]]; then
    private_flag="--inprivate"
  else
    private_flag="--incognito"
  fi
fi

launch_args=()
for arg in "$@"; do
  if [[ $arg == "--private" ]]; then
    launch_args+=("$private_flag")
  else
    launch_args+=("$arg")
  fi
done

if ! browser_handoff "$browser_exec" "${launch_args[@]}"; then
  systemd-run --user --quiet --collect --unit="quattro-browser-$$-${EPOCHREALTIME//[!0-9]/}" \
    --property=StandardOutput=null --property=StandardError=null \
    uwsm-app -- "$browser_exec" "${launch_args[@]}"
fi

url=""
for argument in "$@"; do
  if [[ $argument != "--private" ]]; then
    url=$argument
    break
  fi
done

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  browser_base="${browser_exec##*/}"
  quattro-hyprland-focus-app "^${browser_base%-stable}.*$" || true
fi
