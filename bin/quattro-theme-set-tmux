#!/bin/bash

# quattro:summary=Sync current Quattro theme environment into tmux
# quattro:hidden=true

set -euo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
source "$QUATTRO_PATH/default/bash/lib-common.sh"

CURRENT_THEME_PATH="$HOME/.local/state/quattro/current/theme"
GUM_ENV="$CURRENT_THEME_PATH/gum_env.lua"
COLORS_TOML="$CURRENT_THEME_PATH/colors.toml"

if ! tmux list-sessions >/dev/null 2>&1; then
  exit 0
fi

# Every setting reaches the tmux server as one script. A tmux client per
# variable per session costs several hundred forks on each theme switch.
TMUX_COMMANDS=()
TMUX_SESSIONS=()
declare -A THEME_COLORS=()

# tmux takes single-quoted text literally; a single quote inside one closes
# it, joins a double-quoted quote, and reopens it. The quoting stays in this
# shell: a command substitution per argument would fork once per argument.
queue_tmux_command() {
  local argument quoted line="" quote="'"

  for argument in "$@"; do
    quoted="${argument//$quote/$quote\"$quote\"$quote}"
    line+="${line:+ }$quote$quoted$quote"
  done

  TMUX_COMMANDS+=("$line")
}

queue_tmux_environment() {
  local key="$1"
  local value="$2"
  local session

  queue_tmux_command set-environment -g "$key" "$value"

  for session in "${TMUX_SESSIONS[@]}"; do
    queue_tmux_command set-environment -t "$session" "$key" "$value"
  done
}

# source-file reports a line that fails, such as a session that closed in the
# meantime, and carries on with the rest.
apply_tmux_commands() {
  (( ${#TMUX_COMMANDS[@]} > 0 )) || return 0

  printf '%s\n' "${TMUX_COMMANDS[@]}" | tmux source-file - >/dev/null 2>&1 || true
}

load_tmux_sessions() {
  local session

  while IFS= read -r session; do
    [[ -n $session ]] && TMUX_SESSIONS+=("$session")
  done < <(tmux list-sessions -F "#{session_id}" 2>/dev/null)
}

# One resolver run covers every colour below.
load_theme_colors() {
  local key value

  while IFS=$'\t' read -r key value; do
    THEME_COLORS[$key]="$value"
  done < <(quattro-theme-color --file "$COLORS_TOML" --all 2>/dev/null)
}

sync_theme_environment() {
  local line key value

  [[ -f $GUM_ENV ]] || return

  while IFS= read -r line; do
    if [[ $line =~ hl\.env\(\"([A-Z0-9_]+)\",[[:space:]]*\"([^\"]+)\"\) ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      queue_tmux_environment "$key" "$value"
    fi
  done <"$GUM_ENV"
}

sync_colorfgbg() {
  local colorfgbg="15;0"

  # quattro-theme-color resolves mode from colors.toml, a legacy light.mode
  # file, or background luminance, so a bare light check covers all theme styles.
  if [[ ${THEME_COLORS[mode]:-} == "light" ]]; then
    colorfgbg="0;15"
  fi

  queue_tmux_environment COLORFGBG "$colorfgbg"
}

theme_osc_sequences() {
  local i out=""
  [[ -n ${THEME_COLORS[foreground]:-} ]] && out+=$'\033]10;'"${THEME_COLORS[foreground]}"$'\007'
  [[ -n ${THEME_COLORS[background]:-} ]] && out+=$'\033]11;'"${THEME_COLORS[background]}"$'\007'
  [[ -n ${THEME_COLORS[cursor]:-} ]] && out+=$'\033]12;'"${THEME_COLORS[cursor]}"$'\007'
  [[ -n ${THEME_COLORS[selection_background]:-} ]] && out+=$'\033]17;'"${THEME_COLORS[selection_background]}"$'\007'
  [[ -n ${THEME_COLORS[selection_foreground]:-} ]] && out+=$'\033]19;'"${THEME_COLORS[selection_foreground]}"$'\007'
  for i in {0..15}; do
    [[ -n ${THEME_COLORS[color$i]:-} ]] && out+=$'\033]4;'"$i;${THEME_COLORS[color$i]}"$'\007'
  done
  printf '%s' "$out"
}

sync_tmux_window_style() {
  local foreground="${THEME_COLORS[foreground]:-}"
  local background="${THEME_COLORS[background]:-}"
  local cursor="${THEME_COLORS[cursor]:-}"

  [[ -f $COLORS_TOML && -n $foreground && -n $background ]] || return

  queue_tmux_command set-option -g window-style "fg=$foreground,bg=$background"
  queue_tmux_command set-option -g window-active-style "fg=$foreground,bg=$background"

  # Apps like nvim clear the per-pane cursor colour with OSC 112. Without a
  # global fallback, tmux then resets the outer terminal's cursor, which in
  # terminals that can't reload their config (foot) restores the colour from
  # whatever theme was active when the terminal launched.
  if [[ -n $cursor ]]; then
    queue_tmux_command set-option -g cursor-colour "$cursor"
  fi
}

sync_and_signal_tmux_panes() {
  local pane_tty theme_osc="" tpgid

  if [[ -f $COLORS_TOML ]]; then
    theme_osc=$(theme_osc_sequences)
  fi

  while IFS= read -r pane_tty; do
    [[ $pane_tty == /dev/pts/* ]] || continue
    if [[ -n $theme_osc ]]; then
      printf '%b' "$theme_osc" >"$pane_tty" 2>/dev/null || true
    fi
    tpgid=$(ps -o tpgid= -t "${pane_tty#/dev/}" 2>/dev/null | awk 'NF && $1 > 0 { print $1; exit }')
    [[ -n $tpgid ]] || continue
    kill -WINCH "-$tpgid" 2>/dev/null || true
  done < <(tmux list-panes -a -F "#{pane_tty}" 2>/dev/null | sort -u)
}

refresh_tmux_clients() {
  local client

  while IFS= read -r client; do
    [[ -n $client ]] || continue
    tmux refresh-client -t "$client" 2>/dev/null || true
  done < <(tmux list-clients -F "#{client_name}" 2>/dev/null)
}

load_tmux_sessions
load_theme_colors

sync_theme_environment
sync_colorfgbg
sync_tmux_window_style
apply_tmux_commands
sync_and_signal_tmux_panes
refresh_tmux_clients
