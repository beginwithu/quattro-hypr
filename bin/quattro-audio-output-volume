#!/bin/bash

# quattro:summary=Adjust output volume and show the Quattro OSD
# quattro:args=<raise|lower|mute-toggle|+N|-N>
# quattro:examples=quattro audio output volume raise | quattro audio output volume lower | quattro audio output volume mute-toggle | quattro audio output volume +1


set -uo pipefail

action="${1:-}"

if [[ -z $action ]]; then
  echo "Usage: quattro-audio-output-volume <raise|lower|mute-toggle|+N|-N>"
  exit 1
fi

# Resolve through any DSP sink to the physical one, so the keys always move real
# loudness and the processing always sees full-scale input. Shared with the audio
# panel and the output switcher. Direct alsa_output.* sinks skip spawning quattro-audio.
default_sink="$(pactl get-default-sink 2>/dev/null || true)"
if [[ $default_sink == alsa_output.* ]]; then
  sink="$default_sink"
else
  sink="$(quattro-audio output-sink "$default_sink")"
fi
if [[ -z $sink ]]; then
  echo "Could not resolve an audio sink to control." >&2
  exit 1
fi

# pactl reports the same percentage scale wpctl does (both are the raw volume
# over PA_VOLUME_NORM), so the OSD reads identically either way.
# pactl translates its labels and yes/no; parse them in the C locale.
volume_percent() {
  local line=""
  IFS= read -r line < <(LC_ALL=C pactl get-sink-volume "$sink" 2>/dev/null) || true
  if [[ $line =~ ([0-9]+)% ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  fi
}

volume_muted() {
  [[ $(LC_ALL=C pactl get-sink-mute "$sink" 2>/dev/null) == *yes ]]
}

case "$action" in
  raise) action="+5" ;;
  lower) action="-5" ;;
esac

percent=""
is_muted=0

if [[ $action == "mute-toggle" ]]; then
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  debounce_file="$runtime_dir/quattro-audio-output-volume-mute-toggle.last"
  er="${EPOCHREALTIME//[!0-9]/}"
  now="${er:0:13}"
  last=0
  [[ -r $debounce_file ]] && read -r last <"$debounce_file" || true
  if ((now - last < 250)); then
    exit 0
  fi
  printf '%s\n' "$now" >"$debounce_file"

  pactl set-sink-mute "$sink" toggle
  percent=$(volume_percent)
  volume_muted && is_muted=1
elif [[ $action =~ ^([+-])([0-9]+)$ ]]; then
  direction="${BASH_REMATCH[1]}"
  step="${BASH_REMATCH[2]}"

  current="$(volume_percent)"
  if [[ -z $current ]]; then
    echo "Could not read volume for $sink." >&2
    exit 1
  fi

  if [[ $direction == "+" ]]; then
    next=$((current + step))
    ((next <= 100)) || next=100
  else
    next=$((current - step))
    ((next >= 0)) || next=0
  fi

  pactl set-sink-mute "$sink" 0
  if pactl set-sink-volume "$sink" "${next}%"; then
    percent="$next"
    is_muted=0
  else
    percent=$(volume_percent)
    volume_muted && is_muted=1
  fi
else
  echo "Unknown volume action: $action"
  exit 1
fi

if (( is_muted || ${percent:-0} == 0 )); then
  icon="volume-muted"
else
  icon="volume-high"
fi

exec quattro-osd -i "$icon" -p "${percent:-0}"
