#!/bin/bash

# quattro:summary=Reset user configs in ~/.config to Quattro shipped defaults
# quattro:group=refresh
# quattro:args=<config <path>|hyprland|hyprsunset|shell|tmux>
# quattro:examples=quattro refresh hyprland | quattro refresh shell | quattro refresh config hypr/hyprland.lua

set -euo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"

refresh_config_file() {
  local config_file=${1:-}
  if [[ -z $config_file ]]; then
    echo "Usage: quattro-refresh config <config-path>" >&2
    exit 1
  fi

  local user_config_file="${HOME}/.config/$config_file"
  local default_config_file="$QUATTRO_PATH/config/$config_file"

  if [[ ! -e $default_config_file ]]; then
    echo "Not a shipped user config: $config_file" >&2
    exit 1
  fi

  mkdir -p "${user_config_file%/*}"

  if [[ -f $user_config_file ]] && ! cmp -s "$default_config_file" "$user_config_file"; then
    local diff_output
    diff_output=$(diff "$default_config_file" "$user_config_file" || true)
    cp -f "$default_config_file" "$user_config_file"
    echo -e "\e[31mReplaced $user_config_file with new Quattro default.\n\n\e[32mChanges:\e[0m"
    printf '%s\n' "$diff_output"
  else
    cp -f "$default_config_file" "$user_config_file"
  fi
}

cmd="${1:-}"
(( $# > 0 )) && shift || true

case "$cmd" in
  config)
    refresh_config_file "${1:-}"
    ;;
  hyprland)
    for f in .luarc.json autostart.lua bindings.lua input.lua looknfeel.lua hyprland.lua monitors.lua; do
      refresh_config_file "hypr/$f"
    done
    mkdir -p ~/.local/state/quattro/toggles/hypr
    cp "$QUATTRO_PATH/default/hypr/toggles/flags.lua" ~/.local/state/quattro/toggles/hypr/
    ;;
  hyprsunset)
    refresh_config_file hypr/hyprsunset.conf
    quattro-restart hyprsunset
    ;;
  shell)
    refresh_config_file quattro/shell.json
    quattro-bar defaults
    quattro-restart-shell
    ;;
  tmux)
    refresh_config_file tmux/tmux.conf
    if tmux has-session 2>/dev/null; then
      tmux source-file ~/.config/tmux/tmux.conf
    fi
    ;;
  */*)
    refresh_config_file "$cmd"
    ;;
  *)
    echo "Usage: quattro-refresh <config <path>|hyprland|hyprsunset|shell|tmux>" >&2
    exit 1
    ;;
esac
