#!/bin/bash

# quattro:summary=Open the Quattro theme switcher


set -uo pipefail

print_rows=false

# The shell's picker opens from rows it already holds and runs this to refresh
# them, so the theme list never waits on the index below.
if [[ ${1:-} == "--print-rows" ]]; then
  print_rows=true
  shift
fi

QUATTRO_PATH="${QUATTRO_PATH:-$HOME/.local/share/quattro}"
USER_THEMES_PATH="$HOME/.config/quattro/themes"
QUATTRO_THEMES_PATH="$QUATTRO_PATH/themes"
CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/quattro/theme-selector"
preview_dir="$CACHE_PATH/previews"
signature_file="$CACHE_PATH/signature"
fast_signature_file="$CACHE_PATH/fast-signature"

mkdir -p "$preview_dir"

find_preview() {
  local theme_path="$1"
  local preview preview_name

  for preview_name in preview.webp preview.png preview.jpg preview.jpeg preview.gif preview.bmp preview.mp4 preview.m4v preview.mov preview.webm preview.mkv preview.avi; do
    if [[ -f $theme_path/$preview_name ]]; then
      printf '%s\n' "$theme_path/$preview_name"
      return
    fi
  done

  preview=$(find -L "$theme_path" -maxdepth 1 -type f \
    \( -iname 'preview.webp' -o -iname 'preview.png' -o -iname 'preview.jpg' -o -iname 'preview.jpeg' -o -iname 'preview.gif' -o -iname 'preview.bmp' \
       -o -iname 'preview.mp4' -o -iname 'preview.m4v' -o -iname 'preview.mov' -o -iname 'preview.webm' -o -iname 'preview.mkv' -o -iname 'preview.avi' \) \
    -print -quit 2>/dev/null)
  if [[ -n $preview ]]; then
    printf '%s\n' "$preview"
    return
  fi

  if [[ -d $theme_path/backgrounds ]]; then
    find -L "$theme_path/backgrounds" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \
         -o -iname '*.mp4' -o -iname '*.m4v' -o -iname '*.mov' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.avi' \) \
      -print 2>/dev/null | sort | head -n 1
  fi
}

add_theme_preview() {
  local theme_name="$1"
  local preview="$2"
  local extension="${preview##*.}"
  extension="${extension,,}"

  [[ -n $preview ]] || return
  [[ -e $preview_dir/$theme_name.$extension ]] && return

  ln -s "$preview" "$preview_dir/$theme_name.$extension"
}

fast_signature="v2"$'\n'
stat_targets=()
shopt -s nullglob
for theme_dir in "$USER_THEMES_PATH" "$QUATTRO_THEMES_PATH"; do
  if [[ -d $theme_dir ]]; then
    stat_targets+=("$theme_dir")
    for theme_path in "$theme_dir"/*; do
      [[ -d $theme_path ]] && stat_targets+=("$theme_path")
    done
  fi
done
shopt -u nullglob
if (( ${#stat_targets[@]} > 0 )); then
  fast_signature+="$(stat -Lc '%n:%Y' "${stat_targets[@]}" 2>/dev/null)"$'\n'
fi

cached_fast_sig=""
[[ -r $fast_signature_file ]] && cached_fast_sig=$(<"$fast_signature_file")$'\n'

if [[ $cached_fast_sig != "$fast_signature" ]]; then
  theme_signature=""
  rm -rf "$preview_dir"
  mkdir -p "$preview_dir"

  shopt -s nullglob
  for theme_path in "$USER_THEMES_PATH"/*; do
    [[ -d $theme_path ]] || continue
    theme_name=${theme_path##*/}
    preview=$(find_preview "$theme_path")
    [[ -n $preview ]] || preview=$(find_preview "$QUATTRO_THEMES_PATH/$theme_name")
    add_theme_preview "$theme_name" "$preview"
    theme_signature+="$theme_path:$(stat -Lc '%Y' "$theme_path" 2>/dev/null)"$'\n'
    [[ -n $preview ]] && theme_signature+="$preview:$(stat -Lc '%s:%Y' "$preview" 2>/dev/null)"$'\n'
  done

  for theme_path in "$QUATTRO_THEMES_PATH"/*; do
    [[ -d $theme_path && ! -L $theme_path ]] || continue
    theme_name=${theme_path##*/}
    preview=$(find_preview "$theme_path")
    add_theme_preview "$theme_name" "$preview"
    theme_signature+="$theme_path:$(stat -Lc '%Y' "$theme_path" 2>/dev/null)"$'\n'
    [[ -n $preview ]] && theme_signature+="$preview:$(stat -Lc '%s:%Y' "$preview" 2>/dev/null)"$'\n'
  done
  shopt -u nullglob

  printf '%s' "$theme_signature" >"$signature_file"
  printf '%s' "$fast_signature" >"$fast_signature_file"
fi

current_theme=""
[[ -r $HOME/.local/state/quattro/current/theme.name ]] && current_theme=$(<"$HOME/.local/state/quattro/current/theme.name")
selected_preview=""
for extension in webp png jpg jpeg gif bmp mp4 m4v mov webm mkv avi; do
  if [[ -e $preview_dir/$current_theme.$extension ]]; then
    selected_preview="$preview_dir/$current_theme.$extension"
    break
  fi
done
menu_args=(
  --print-name
  --show-labels
  --filterable
  --lazy-thumbnails
  --selected "$selected_preview"
)

if [[ $print_rows == true ]]; then
  menu_args+=(--print-rows)
fi

exec quattro-menu-images "${menu_args[@]}" "$preview_dir"
