#!/bin/bash

# quattro:summary=Launch the fastfetch TUI that gives information about the current system.

# The size that hugs the About content depends on the terminal font and the user's
# logo, so it can only be measured from inside the terminal. We remember the size
# that fit and apply it as a window rule before launching, so the window opens at
# it instead of resizing after the first paint. Bash defers WINCH traps while read
# blocks, so poll for size changes and re-render fastfetch whenever it is resized.


set -uo pipefail

QUATTRO_PATH="${QUATTRO_PATH:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)}"
LOGO_FILE="$HOME/.config/quattro/branding/about.txt"
FIT_FILE="$HOME/.local/state/quattro/windows/about.fit"
QUATTRO_FASTFETCH_DIR=/etc/fastfetch
# Without a runtime directory there is nowhere private to put the translated
# copy, so the untranslated config runs as it is.
ABOUT_CONFIG=${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/quattro/about-fastfetch.jsonc}

# Right padding mirrors the rendered left margin (clamped to this range) so the
# window hugs the content symmetrically on both stock and custom fastfetch
# layouts. The cursor sits one row below fastfetch's trailing break line, which
# already balances the top break rows without needing extra blank rows at the
# bottom.
FIT_MIN_RIGHT_PAD=2
FIT_MAX_RIGHT_PAD=4
FIT_SPARE_ROWS=0

POLL_SECONDS=0.5

# A user copy that still matches Quattro's own fastfetch config byte-for-byte
# (e.g. seeded by an older installer run) is not a custom layout.
is_stock_fastfetch_config() {
  local candidate=$1
  local stock

  for stock in "$QUATTRO_FASTFETCH_DIR/config.jsonc" "$QUATTRO_PATH/etc/fastfetch/config.jsonc"; do
    [[ -f $stock ]] && cmp -s "$candidate" "$stock" && return 0
  done

  return 1
}

# Print the active user fastfetch config path when it differs from Quattro's
# stock config. It can sit in any of several directories fastfetch searches
# ahead of Quattro's own, so ask fastfetch for that order rather than keep a
# copy here for its next release to outdate.
active_custom_fastfetch_config() {
  local directory candidate listed=false

  # A whole line at a time, because a home directory may contain a space, and the
  # marker fastfetch puts beside the config it settled on is not part of the path.
  while IFS= read -r directory; do
    listed=true
    directory=${directory% (\*)}
    [[ ${directory%/} == "$QUATTRO_FASTFETCH_DIR" ]] && return 1
    candidate=${directory%/}/config.jsonc
    if [[ -f $candidate ]]; then
      is_stock_fastfetch_config "$candidate" && return 1
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(fastfetch --list-config-paths 2>/dev/null)

  # Silence is not the same answer as "none of them", so fall back to the
  # directory fastfetch has always looked in first rather than read it as one.
  [[ $listed == true ]] && return 1
  if [[ -f $HOME/.config/fastfetch/config.jsonc ]] && ! is_stock_fastfetch_config "$HOME/.config/fastfetch/config.jsonc"; then
    printf '%s\n' "$HOME/.config/fastfetch/config.jsonc"
    return 0
  fi

  return 1
}

custom_fastfetch_config() {
  active_custom_fastfetch_config >/dev/null
}

# wc -L counts display columns only in a UTF-8 locale. A session that never set
# one counts every box-drawing and Nerd Font glyph in the About layout as
# nothing, which measures the content narrower than it renders.
display_columns() {
  LC_ALL=C.UTF-8 wc -L
}

# A section heading as the config draws it: the title centred in the 52 columns
# between the box corners.
about_heading() {
  local title=$1 width left right bar="────────────────────────────────────────────────────"
  width=$(printf '%s' "$title" | display_columns)
  left=$(( (52 - width + 1) / 2 ))
  right=$(( 52 - width - left ))
  (( left > 0 )) || left=1
  (( right > 0 )) || right=1
  printf '\e[90m┌%s%s%s┐' "${bar:0:left}" "$title" "${bar:0:right}"
}

# fastfetch has no translations of its own, so the About box runs from a copy of
# Quattro's config with its section headings and keys in the current language.
# Rows the copy does not recognise, as after a user edit, stay as they are.
write_about_config() {
  local headings keys

  [[ -n $ABOUT_CONFIG ]] || return 0

  headings=$(jq -n \
    --arg hardware "$(about_heading Hardware)" --arg hardware_to "$(about_heading "$(quattro-i18n about.hardware)")" \
    --arg software "$(about_heading Software)" --arg software_to "$(about_heading "$(quattro-i18n about.software)")" \
    --arg age "$(about_heading "Age / Uptime / Update")" --arg age_to "$(about_heading "$(quattro-i18n about.ageUptimeUpdate)")" \
    '{($hardware): $hardware_to, ($software): $software_to, ($age): $age_to}')
  keys=$(jq -n \
    --arg age "$(quattro-i18n about.osAge)" --arg uptime "$(quattro-i18n about.uptime)" --arg update "$(quattro-i18n about.update)" \
    '{"OS Age": $age, "Uptime": $uptime, "Update": $update}')

  mkdir -p "${ABOUT_CONFIG%/*}"
  if jq --argjson headings "$headings" --argjson keys "$keys" '
    .modules |= map(
      if type == "object" and .type == "custom" and $headings[.format] then .format = $headings[.format]
      elif type == "object" and (.key // "" | test("^\\S+ ")) then
        (.key | capture("^(?<icon>\\S+) (?<label>.+)$")) as $k
        | if $keys[$k.label] then .key = "\($k.icon) \($keys[$k.label])" else . end
      else . end
    )' "$QUATTRO_FASTFETCH_DIR/config.jsonc" >"$ABOUT_CONFIG.new"
  then
    mv "$ABOUT_CONFIG.new" "$ABOUT_CONFIG"
  else
    # fastfetch reads JSONC; jq does not, so a comment or trailing comma ends
    # here, and the untranslated config runs rather than an empty copy.
    rm -f "$ABOUT_CONFIG.new" "$ABOUT_CONFIG"
  fi
}

# A user's own fastfetch config runs as it is; otherwise the translated copy does.
about_fastfetch() {
  if [[ -n $ABOUT_CONFIG && -f $ABOUT_CONFIG ]] && ! custom_fastfetch_config; then
    fastfetch -c "$ABOUT_CONFIG" "$@"
  else
    fastfetch "$@"
  fi
}

logo_dimensions() {
  [[ -f $LOGO_FILE ]] || return 1
  printf '%s %s' "$(display_columns <"$LOGO_FILE")" "$(wc -l <"$LOGO_FILE")"
}

fit_signature() {
  local config config_stat logo_w logo_h raw sig

  if config=$(active_custom_fastfetch_config); then
    config_stat=$(stat -c '%Y:%s' "$config" 2>/dev/null || printf '0:0')
    raw="v2:custom:$config:$config_stat"
  else
    read -r logo_w logo_h <<<"$(logo_dimensions 2>/dev/null || true)"
    [[ -n ${logo_w:-} ]] || return 1
    config_stat=$(stat -c '%Y:%s' "$QUATTRO_FASTFETCH_DIR/config.jsonc" 2>/dev/null || printf '0:0')
    raw="v2:stock:$config_stat:${logo_w}x${logo_h}"
  fi

  read -r sig _ < <(printf '%s' "$raw" | sha256sum)
  printf '%s' "$sig"
}

hypr_dispatch() {
  local lua="$1" output status
  shift
  output=$(hyprctl dispatch "$lua" 2>&1)
  status=$?
  if (( status == 0 )) && [[ -z $output || $output == "ok" ]]; then
    return 0
  fi
  hyprctl dispatch "$@" >/dev/null
}

remember_fit() {
  local directory="${FIT_FILE%/*}" tmp
  mkdir -p "$directory"
  tmp=$(mktemp "$directory/.about.fit.XXXXXX")
  printf '%s %s %s\n' "$1" "$2" "$3" >"$tmp"
  mv "$tmp" "$FIT_FILE"
}

# Replaces the rule from the last launch so a remembered size never outlives the
# fit it came from. Called without one it only clears, leaving the float rule's
# starting size — where a Hyprland without the Lua API stays too.
apply_size_rule() {
  local rule=""
  (( $# == 2 )) && rule="quattro_about_size_rule = hl.window_rule({ match = { class = \"org.quattro.about\" }, size = { $1, $2 } })"

  hyprctl eval "if quattro_about_size_rule then quattro_about_size_rule:set_enabled(false) end; quattro_about_size_rule = nil; $rule" >/dev/null 2>&1
}

# Sized before the terminal is spawned, so the window maps at its final size.
presize_window() {
  local sig fit_sig fit_w fit_h

  if [[ -r $FIT_FILE ]]; then
    sig=$(fit_signature 2>/dev/null || true)
    read -r fit_sig fit_w fit_h <"$FIT_FILE"

    # A different config or logo needs a different window, so leave that launch
    # to the float rule and let fit_window measure the new size.
    if [[ -n ${sig:-} && $sig == "$fit_sig" ]] &&
      [[ $fit_w =~ ^[0-9]+$ && $fit_h =~ ^[0-9]+$ ]]; then
      apply_size_rule "$fit_w" "$fit_h"
      return
    fi
  fi

  apply_size_rule
}

# Hyprland animates a resize and the terminal reflows to every step of it, so
# wait for the grid to hold still before measuring it.
settle_grid() {
  local current previous="" held=0

  for _ in {1..20}; do
    current=$(stty size)
    if [[ $current == $previous ]]; then
      (( ++held == 3 )) && break
    else
      held=0
      previous=$current
    fi
    sleep 0.05
  done
}

fit_window() {
  local sig
  sig=$(fit_signature 2>/dev/null || true)
  [[ -n ${sig:-} ]] || return 1

  measure_layout || return 1

  local right_pad=$LAYOUT_LEFT_PAD
  (( right_pad < FIT_MIN_RIGHT_PAD )) && right_pad=$FIT_MIN_RIGHT_PAD
  (( right_pad > FIT_MAX_RIGHT_PAD )) && right_pad=$FIT_MAX_RIGHT_PAD

  local target_c=$(( LAYOUT_COLS + right_pad ))
  local target_r=$(( LAYOUT_ROWS + 1 + FIT_SPARE_ROWS ))

  local nudges=0 rows cols address width height shift_w shift_h target_w target_h
  while :; do
    read -r rows cols <<<"$(stty size)"
    read -r address width height <<<"$(hyprctl clients -j | jq -r '.[] | select(.class == "org.quattro.about") | "\(.address) \(.size[0]) \(.size[1])"')"
    [[ -n ${address:-} ]] || return 1
    (( cols > 0 && rows > 0 && width > 0 && height > 0 )) || return 1

    # A window has to land on the terminal's cell boundaries, so take a cell of
    # slack over chasing an exact grid, and remember where it came to rest.
    if (( cols >= target_c && cols <= target_c + 1 && rows >= target_r && rows <= target_r + 1 )); then
      remember_fit "$sig" "$width" "$height"
      return 0
    fi

    # Three nudges is the budget, and each one is measured before the next is spent.
    (( ++nudges <= 3 )) || return 1

    # Move by the cells the window is off by, rather than scaling it to the grid,
    # which would multiply up the terminal's padding along with them. Dividing a
    # window that carries that padding still leaves the cell a touch generous, so
    # round the move away from the grid that would clip.
    shift_w=$(( (target_c - cols) * width ))
    shift_h=$(( (target_r - rows) * height ))
    target_w=$(( width + (shift_w >= 0 ? (shift_w + cols - 1) / cols : shift_w / cols) ))
    target_h=$(( height + (shift_h >= 0 ? (shift_h + rows - 1) / rows : shift_h / rows) ))

    hypr_dispatch "hl.dsp.window.resize({ window = \"address:$address\", x = $target_w, y = $target_h })" resizewindowpixel "exact $target_w $target_h,address:$address"
    hypr_dispatch "hl.dsp.window.center({ window = \"address:$address\" })" centerwindow
    settle_grid
  done

  return 1
}

measure_layout() {
  [[ -n ${LAYOUT_ROWS:-} && -n ${LAYOUT_COLS:-} ]] && return 0

  local rendered clean
  # Pipe mode lays out logo, padding, and modules on plain lines so one pass
  # measures both stock and custom fastfetch configs accurately.
  rendered=$(about_fastfetch --pipe true 2>/dev/null; printf X)
  rendered=${rendered%X}
  clean=$(printf '%s' "$rendered" | sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r//g'; printf X)
  clean=${clean%X}

  LAYOUT_ROWS=$(printf '%s' "$clean" | wc -l)
  LAYOUT_COLS=$(printf '%s' "$clean" | display_columns)
  LAYOUT_LEFT_PAD=$(printf '%s\n' "$clean" | awk '
    /[^ ]/ {
      match($0, /^ */)
      if (min == "" || RLENGTH < min) min = RLENGTH
    }
    END { print (min == "" ? 0 : min) }
  ')
  (( LAYOUT_ROWS > 0 && LAYOUT_COLS > 0 ))
}

# What the frames were built against. A window that resized, or a logo/config
# that changed, needs fastfetch run again before anything is drawn over it.
content_changed() {
  [[ $resized == true ]] && return 0

  [[ $(stty size) != "$grid" || $(stat -c %Y "$WATCH_FILE" 2>/dev/null) != "$watch_stamp" ]]
}

# A tick either times out, which is the delay, or a key arrives and About closes.
# Anything else on stdin is a terminal that went away, which closes it too.
tick() {
  read -t "$1" -n 1 -s && exit
  (( $? > 128 )) || exit
}

if [[ ${1:-} == "--render" ]]; then
  printf '\e[?25l'
  write_about_config
  WATCH_FILE=$(active_custom_fastfetch_config 2>/dev/null || printf '%s' "$LOGO_FILE")

  resized=false
  trap 'resized=true' WINCH

  # Give the compositor a moment to apply the window rules before measuring cells.
  settle_grid

  fitted=false
  passes=0
  while :; do
    grid=$(stty size)
    watch_stamp=$(stat -c %Y "$WATCH_FILE" 2>/dev/null)
    resized=false
    LAYOUT_ROWS=""
    LAYOUT_COLS=""
    LAYOUT_LEFT_PAD=""
    clear
    about_fastfetch
    if [[ $fitted == false ]] && (( ++passes <= 2 )); then
      fit_window && fitted=true
      [[ $resized == true ]] && continue
    fi
    while ! content_changed; do
      tick "$POLL_SECONDS"
    done
    if [[ $(stat -c %Y "$WATCH_FILE" 2>/dev/null) != $watch_stamp ]]; then
      fitted=false
      passes=0
    fi
  done
fi

presize_window
exec quattro-launch-or-focus-tui --app-id=org.quattro.about quattro-launch-about --render
