#!/bin/bash

# quattro:summary=Pick one or multiple options from a menu
# quattro:group=menu
# quattro:name=select
# quattro:args=prompt [option...] [-- --multiple --selected <value> --on-change <command-json> --change-key <key> --width <pixels> --maxheight <pixels>]
# quattro:examples=quattro menu select Format jpg png|quattro-menu-select Resolution 4k 1080p 720p -- --width 400

# An option may lead with an icon, as "<glyph><TAB><label>", and may trail a
# subtext shown under the label, as "<glyph><TAB><label><TAB><subtext>". The
# menu shows the glyph but never returns it. A plain option returns the label
# alone; an option with a subtext returns "<label><TAB><subtext>", so callers
# with same-named rows get the subtext back as the stable key.

# With --multiple, clicking/Enter toggles rows and Apply returns a JSON array.
# --on-change takes a JSON command array; each toggle runs it with the selection
# JSON appended, applies immediately, and needs no Apply row. A successful
# command may print a JSON array of actual selections to update the checkmarks.
# --selected takes a returned value (label plus any subtext), and can be repeated.

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: quattro-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
menu_width=""
menu_maxheight=""
multiple=0
on_change="[]"
change_key=""
selected=()

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    shift
    while (( $# > 0 )); do
      case "$1" in
        --on-change)
          shift
          if (( $# == 0 )); then
            echo "quattro-menu-select: --on-change requires a JSON command array" >&2
            exit 1
          fi
          on_change="$1"
          ;;
        --change-key)
          shift
          if (( $# == 0 )); then
            echo "quattro-menu-select: --change-key requires a value" >&2
            exit 1
          fi
          change_key="$1"
          ;;
        --multiple)
          multiple=1
          ;;
        --selected)
          shift
          if (( $# == 0 )); then
            echo "quattro-menu-select: --selected requires a value" >&2
            exit 1
          fi
          selected+=("$1")
          ;;
        --width)
          shift
          if (( $# == 0 )); then
            echo "quattro-menu-select: --width requires a value" >&2
            exit 1
          fi
          menu_width="$1"
          ;;
        --height|--maxheight)
          arg="$1"
          shift
          if (( $# == 0 )); then
            echo "quattro-menu-select: $arg requires a value" >&2
            exit 1
          fi
          menu_maxheight="$1"
          ;;
      esac
      shift
    done
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

if (( ${#options[@]} == 0 )); then
  echo "Usage: quattro-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

multiple_json=false
(( multiple )) && multiple_json=true

payload=$(jq -nc \
  --arg prompt "$prompt" \
  --arg selectionFile "$selection_file" \
  --arg doneFile "$done_file" \
  --arg width "$menu_width" \
  --arg maxHeight "$menu_maxheight" \
  --argjson multiple "$multiple_json" \
  --argjson onChange "$on_change" \
  --arg changeKey "$change_key" \
  --argjson n_options "${#options[@]}" \
  '{
    mode: "select",
    prompt: $prompt,
    options: $ARGS.positional[0:$n_options],
    multiple: $multiple,
    selected: $ARGS.positional[$n_options:],
    onChange: $onChange,
    changeKey: $changeKey,
    selectionFile: $selectionFile,
    doneFile: $doneFile
  }
  + (if $width != "" then { width: ($width | tonumber | trunc) } else {} end)
  + (if $maxHeight != "" then { maxHeight: ($maxHeight | tonumber | trunc) } else {} end)' \
  --args -- "${options[@]}" ${selected[@]+"${selected[@]}"})

quattro-shell shell summon quattro.menu "$payload" >/dev/null || exit 2

next_probe=$((SECONDS + 2))
consecutive_misses=0
while [[ ! -e $done_file ]]; do
  sleep 0.05
  [[ -e $done_file ]] && break
  if (( SECONDS >= next_probe )); then
    if quattro-shell shell ping >/dev/null 2>&1; then
      consecutive_misses=0
      next_probe=$((SECONDS + 1))
    else
      [[ -e $done_file ]] && break
      consecutive_misses=$((consecutive_misses + 1))
      (( consecutive_misses >= 2 )) && break
      next_probe=$((SECONDS + 1))
    fi
  fi
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
