#!/bin/bash

# quattro:summary=Command, browser handler, and working directory helpers
# quattro:group=cmd
# quattro:args=<present|missing|default-browser|terminal-cwd> [args...]
# quattro:hidden=true

set -euo pipefail

cmd_present() {
  local c
  for c in "$@"; do
    command -v -- "$c" &>/dev/null || return 1
  done
  return 0
}

cmd_missing() {
  local c
  for c in "$@"; do
    if ! command -v -- "$c" &>/dev/null; then
      return 0
    fi
  done
  return 1
}

cmd_default_browser() {
  local -a data_dirs=() config_dirs=() desktops=() entries=()
  local config_dir desktop list entry browser cache
  IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  IFS=: read -ra config_dirs <<<"${XDG_CONFIG_HOME:-$HOME/.config}:${XDG_CONFIG_DIRS:-/etc/xdg}"
  IFS=: read -ra desktops <<<"${XDG_CURRENT_DESKTOP:-}"

  installed() {
    local data_dir cmd
    for data_dir in "${data_dirs[@]}"; do
      [[ -r $data_dir/applications/$1 ]] || continue
      cmd=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$data_dir/applications/$1" | head -1)
      [[ -n $cmd ]] && command -v "$cmd" >/dev/null
      return
    done
    return 1
  }

  for config_dir in "${config_dirs[@]}"; do
    for desktop in "${desktops[@]}" ""; do
      list="$config_dir/${desktop:+${desktop,,}-}mimeapps.list"
      [[ -f $list ]] || continue

      local raw_entries
      raw_entries=$(awk '
        /^\[Default Applications\]/ { section = 1; next }
        /^\[/ { section = 0 }
        section && index($0, "x-scheme-handler/http=") == 1 { print substr($0, 23); exit }
      ' "$list")

      IFS=';' read -ra entries <<<"$raw_entries"
      for entry in "${entries[@]}"; do
        if [[ -n $entry && $entry != "quattro-browser.desktop" ]] && installed "$entry"; then
          echo "$entry"
          return 0
        fi
      done
    done
  done

  browser=$(env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings get default-web-browser 2>/dev/null || true)
  if [[ -n $browser && $browser != "quattro-browser.desktop" ]] && installed "$browser"; then
    echo "$browser"
    return 0
  fi

  browser=$(XDG_CURRENT_DESKTOP= xdg-mime query default x-scheme-handler/https 2>/dev/null || true)
  if [[ -n $browser && $browser != "quattro-browser.desktop" ]] && installed "$browser"; then
    echo "$browser"
    return 0
  fi

  for data_dir in "${data_dirs[@]}"; do
    cache="$data_dir/applications/mimeinfo.cache"
    [[ -r $cache ]] || continue

    local raw_entries
    raw_entries=$(sed -n 's|^x-scheme-handler/https=||p' "$cache")
    IFS=';' read -ra entries <<<"$raw_entries"
    for entry in "${entries[@]}"; do
      if [[ -n $entry && $entry != "quattro-browser.desktop" ]] && installed "$entry"; then
        echo "$entry"
        return 0
      fi
    done
  done

  return 1
}

cmd_terminal_cwd() {
  local terminal_pid=${1:-$(hyprctl activewindow 2>/dev/null | awk '/pid:/ {print $2}' || true)}
  local cwd="" exe_path shell_pid children_file child stat session tty_nr shell
  local -a children=()

  if [[ -n $terminal_pid ]]; then
    exe_path=$(readlink "/proc/$terminal_pid/exe" 2>/dev/null || true)
    if [[ $exe_path == */nautilus ]]; then
      cwd=$(readlink -f "/proc/$terminal_pid/cwd" 2>/dev/null || true)
    else
      shell_pid=""
      for children_file in /proc/"$terminal_pid"/task/*/children; do
        [[ -r $children_file ]] || continue
        read -ra children <"$children_file" || true
        for child in "${children[@]}"; do
          (( child > ${shell_pid:-0} )) && shell_pid=$child
        done
      done

      if [[ -n $shell_pid ]] && read -r stat 2>/dev/null <"/proc/$shell_pid/stat"; then
        read -r _ _ _ session tty_nr _ <<<"${stat##*) }"
        if (( session == shell_pid && tty_nr != 0 )); then
          cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null || true)
          shell=$(readlink -f "/proc/$shell_pid/exe" 2>/dev/null || true)
          grep -Fqsx "$shell" /etc/shells || cwd=""
        fi
      fi
    fi
  fi

  if [[ -n $cwd && -d $cwd ]]; then
    echo "$cwd"
  else
    echo "$HOME"
  fi
}

subcmd="${1:-}"
(( $# > 0 )) && shift || true

case "$subcmd" in
  present) cmd_present "$@" ;;
  missing) cmd_missing "$@" ;;
  default-browser) cmd_default_browser "$@" ;;
  terminal-cwd) cmd_terminal_cwd "$@" ;;
  *)
    echo "Usage: quattro-cmd <present|missing|default-browser|terminal-cwd> [args...]" >&2
    exit 1
    ;;
esac
