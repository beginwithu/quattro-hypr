#!/bin/bash

# quattro:summary=Update Quattro and system packages
# quattro:alias=quattro up
# quattro:args=[-y]
# quattro:examples=quattro update | quattro update -y
# quattro:requires-sudo=true

set -euo pipefail

confirm=true
if [[ ${1:-} == "-y" ]]; then
  confirm=false
fi

if $confirm && command -v gum >/dev/null 2>&1; then
  gum confirm "Update system and AUR packages?" || exit 0
fi

echo "==> Updating Arch packages..."
if $confirm; then
  sudo pacman -Syu
else
  sudo pacman -Syu --noconfirm
fi

if command -v yay >/dev/null 2>&1; then
  echo "==> Updating AUR packages..."
  if $confirm; then
    yay -Sua
  else
    yay -Sua --noconfirm
  fi
fi

quattro-shell -q quattro.system-update clear >/dev/null 2>&1 || true
quattro-hook post-update >/dev/null 2>&1 || true
echo "==> Update complete."
