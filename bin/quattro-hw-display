#!/bin/bash

# quattro:summary=Print the most likely display backlight device.
# quattro:examples=quattro-hw-display

set -euo pipefail

backlight_path="${QUATTRO_BACKLIGHT_PATH:-/sys/class/backlight}"

usable() {
  [[ -n ${1:-} ]]
}

# Start with the first possible output, then refine to the most likely given an order heuristic.
device=""
while IFS= read -r name; do
  if usable "$name"; then
    device="$name"
    break
  fi
done < <(ls -1 "$backlight_path" 2>/dev/null || true)

# Prefer dedicated GPU and ACPI backlight interfaces in standard order.
for candidate in "$backlight_path"/amdgpu_bl* "$backlight_path"/intel_backlight "$backlight_path"/nvidia_* "$backlight_path"/acpi_video*; do
  if [[ -e $candidate ]] && usable "${candidate##*/}"; then
    device="${candidate##*/}"
    break
  fi
done

if [[ -n $device ]]; then
  printf '%s\n' "$device"
else
  exit 1
fi
