#!/bin/bash

# quattro:summary=Launch a terminal in the active terminal's current directory (or attach to tmux with --tmux)
# quattro:args=[--pid=<terminal-pid>] [--tmux] [command...]

set -euo pipefail

pid=""
if [[ ${1:-} == --pid=* ]]; then
  pid=${1#--pid=}
  shift
fi

if [[ ${1:-} == "--tmux" ]]; then
  shift
  set -- bash -c "tmux attach || tmux new -s Work"
fi

exec setsid uwsm-app -- xdg-terminal-exec --dir="$(quattro-cmd terminal-cwd "$pid")" "$@"
