  "remove.security.sshd": {"icon":"󰣀","label":"SSHD","when":"systemctl is-enabled --quiet sshd","action":"quattro-launch-floating-terminal-with-presentation 'quattro-remove-security sshd'"},
  "remove.security.ssh-agent": {"icon":"󰣀","label":"SSH Agent","when":"systemctl --user -q is-enabled gcr-ssh-agent.socket","action":"quattro-launch-floating-terminal-with-presentation 'quattro-remove-security ssh-agent'"},

