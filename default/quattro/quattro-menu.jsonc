{
  // Quattro menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here.
  // Optional fields:
  //   aliases        alternate `quattro menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps","action":"quattro-shell quattro.dock apps"},
  "appearance": {"icon":"󰏘","label":"Appearance","aliases":["style"]},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "learn": {"icon":"󰧑","label":"Learn"},
  "about": {"icon":"","label":"About","action":"quattro-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"quattro-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"quattro-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! quattro-toggle --enabled suspend-off && ! quattro-system --sleep-disabled","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"quattro-hibernation available && ! quattro-system --sleep-disabled","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"quattro-system logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"quattro-system reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"quattro-system shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"quattro-menu-keybindings"},
  "learn.quattro": {"icon":"","label":"Quattro","action":"quattro-launch-browser 'https://github.com/beginwithu/quattro-hypr'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"quattro-launch-browser 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"quattro-launch-browser 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"quattro-launch-browser 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"quattro-menu-tmux-keybindings"},

  // Appearance
  "appearance.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"quattro-shell shell summon quattro.image-picker '{\"source\":\"themes\"}'"},
  "appearance.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(quattro-theme-bg switcher); [[ -n $background ]] && quattro-theme-bg set \"$background\""},
  "appearance.font": {"icon":"","label":"Font","provider":"fonts"},
  "appearance.top-bar": {"icon":"󰍜","label":"Menu Bar"},
  "appearance.top-bar.hide": {"icon":"󰈉","label":"Hide Bar","when":"! quattro-toggle --enabled bar-off","action":"quattro-toggle bar"},
  "appearance.top-bar.show": {"icon":"󰈈","label":"Show Bar","when":"quattro-toggle --enabled bar-off","action":"quattro-toggle bar"},
  "appearance.top-bar.position": {"icon":"","label":"Position Bar"},
  "appearance.top-bar.background": {"icon":"󰂵","label":"Bar Background"},
  "appearance.top-bar.background.opaque": {"icon":"󰝤","label":"Opaque Bar","checked":"[[ $(quattro-bar background) == \"opaque\" ]]","action":"quattro-bar background opaque"},
  "appearance.top-bar.background.glassy": {"icon":"󰂵","label":"Glassy Bar","checked":"[[ $(quattro-bar background) == \"glassy\" ]]","action":"quattro-bar background glassy"},
  "appearance.top-bar.background.clear": {"icon":"󰝣","label":"Clear Bar","checked":"[[ $(quattro-bar background) == \"none\" ]]","action":"quattro-bar background none"},
  "appearance.top-bar.indicators": {"icon":"󰋽","label":"Bar Indicators"},
  "appearance.top-bar.indicators.battery-percentage-on": {"icon":"󰁹","label":"Show Battery %","when":"quattro-hw laptop && [[ $(quattro-bar get quattro.power showPercentage) != true ]]","action":"quattro-shell quattro.power togglePercentage"},
  "appearance.top-bar.indicators.battery-percentage-off": {"icon":"󰁹","label":"Hide Battery %","when":"quattro-hw laptop && [[ $(quattro-bar get quattro.power showPercentage) == true ]]","action":"quattro-shell quattro.power togglePercentage"},
  "appearance.top-bar.indicators.clock": {"icon":"󰥔","label":"Clock"},
  "appearance.top-bar.indicators.clock.sunday-24h": {"icon":"󰥔","label":"Sunday 14:30","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"dddd HH:mm\" ]]","action":"quattro-bar set quattro.clock format \"dddd HH:mm\""},
  "appearance.top-bar.indicators.clock.sunday-12h": {"icon":"󰥔","label":"Sunday 2:30 PM","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"dddd h:mm AP\" ]]","action":"quattro-bar set quattro.clock format \"dddd h:mm AP\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {"icon":"󰥔","label":"Sunday 14:30:05","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"dddd HH:mm:ss\" ]]","action":"quattro-bar set quattro.clock format \"dddd HH:mm:ss\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {"icon":"󰥔","label":"Sunday 2:30:05 PM","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"dddd h:mm:ss AP\" ]]","action":"quattro-bar set quattro.clock format \"dddd h:mm:ss AP\""},
  "appearance.top-bar.indicators.clock.time-24h": {"icon":"󰥔","label":"14:30","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"HH:mm\" ]]","action":"quattro-bar set quattro.clock format \"HH:mm\""},
  "appearance.top-bar.indicators.clock.time-12h": {"icon":"󰥔","label":"2:30 PM","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"h:mm AP\" ]]","action":"quattro-bar set quattro.clock format \"h:mm AP\""},
  "appearance.top-bar.indicators.clock.date-24h": {"icon":"󰥔","label":"Sun 3 May 14:30","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"ddd d MMM HH:mm\" ]]","action":"quattro-bar set quattro.clock format \"ddd d MMM HH:mm\""},
  "appearance.top-bar.indicators.clock.date-12h": {"icon":"󰥔","label":"Sun 3 May 2:30 PM","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"ddd d MMM h:mm AP\" ]]","action":"quattro-bar set quattro.clock format \"ddd d MMM h:mm AP\""},
  "appearance.top-bar.indicators.clock.week": {"icon":"󰥔","label":"3 May W18 2026","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"d MMMM 'W'ww yyyy\" ]]","action":"quattro-bar set quattro.clock format \"d MMMM 'W'ww yyyy\""},
  "appearance.top-bar.indicators.clock.iso": {"icon":"󰥔","label":"2026-05-03 14:30","when":"[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock format) == \"yyyy-MM-dd HH:mm\" ]]","action":"quattro-bar set quattro.clock format \"yyyy-MM-dd HH:mm\""},
  "appearance.top-bar.indicators.clock.stacked-24h": {"icon":"󰥔","label":"14 — 30","when":"[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock verticalFormat) == $'HH\\n—\\nmm' ]]","action":"quattro-bar set quattro.clock verticalFormat $'HH\\n—\\nmm'"},
  "appearance.top-bar.indicators.clock.stacked-12h": {"icon":"󰥔","label":"2 — 30 PM","when":"[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock verticalFormat) == $'h\\n—\\nmm\\nAP' ]]","action":"quattro-bar set quattro.clock verticalFormat $'h\\n—\\nmm\\nAP'"},
  "appearance.top-bar.indicators.clock.stacked-date": {"icon":"󰥔","label":"03 May W18 '26","when":"[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock verticalFormat) == $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy' ]]","action":"quattro-bar set quattro.clock verticalFormat $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy'"},
  "appearance.top-bar.indicators.clock.stacked-time": {"icon":"󰥔","label":"14 30","when":"[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]","checked":"[[ $(quattro-bar get quattro.clock verticalFormat) == $'HH\\nmm' ]]","action":"quattro-bar set quattro.clock verticalFormat $'HH\\nmm'"},
  "appearance.top-bar.position.top": {"icon":"󰁝","label":"Top Bar","action":"quattro-bar position top"},
  "appearance.top-bar.position.bottom": {"icon":"󰁅","label":"Bottom Bar","action":"quattro-bar position bottom"},
  "appearance.top-bar.position.left": {"icon":"󰁍","label":"Left Bar","action":"quattro-bar position left"},
  "appearance.top-bar.position.right": {"icon":"󰁔","label":"Right Bar","action":"quattro-bar position right"},
  "appearance.windows": {"icon":"󰖲","label":"Windows"},
  "appearance.windows.gaps-on": {"icon":"","label":"Enable Window Gaps","when":"quattro-hyprland-toggle --enabled window-no-gaps","action":"quattro-hyprland-window gaps-toggle"},
  "appearance.windows.gaps-off": {"icon":"","label":"Disable Window Gaps","when":"! quattro-hyprland-toggle --enabled window-no-gaps","action":"quattro-hyprland-window gaps-toggle"},
  "appearance.windows.corners": {"icon":"󰘇","label":"Window Corners"},
  "appearance.windows.corners.theme": {"icon":"󰏘","label":"Theme Corners","checked":"[[ $(quattro-hyprland-corners) == \"theme\" ]]","action":"quattro-hyprland-corners theme"},
  "appearance.windows.corners.sharp": {"icon":"󰝣","label":"Sharp Corners","checked":"[[ $(quattro-hyprland-corners) == \"sharp\" ]]","action":"quattro-hyprland-corners sharp"},
  "appearance.windows.corners.rounded": {"icon":"󰘇","label":"Rounded Corners","checked":"[[ $(quattro-hyprland-corners) == \"rounded\" ]]","action":"quattro-hyprland-corners rounded"},
  "appearance.windows.transparency": {"icon":"󰂵","label":"Window Opacity"},
  "appearance.windows.transparency.opaque": {"icon":"󰝤","label":"Opaque Windows","checked":"[[ $(quattro-hyprland-window transparency) == \"opaque\" ]]","action":"quattro-hyprland-window transparency opaque"},
  "appearance.windows.transparency.transparent": {"icon":"󰝣","label":"Transparent Windows","checked":"[[ $(quattro-hyprland-window transparency) == \"transparent\" ]]","action":"quattro-hyprland-window transparency transparent"},
  "appearance.windows.transparency.glassy": {"icon":"󰂵","label":"Glassy Windows","checked":"[[ $(quattro-hyprland-window transparency) == \"glassy\" ]]","action":"quattro-hyprland-window transparency glassy"},
  "appearance.windows.one-window-ratio-on": {"icon":"","label":"Enable 1-Window Ratio","when":"! quattro-hyprland-toggle --enabled single-window-aspect-ratio","action":"quattro-hyprland-window single-square-aspect-toggle"},
  "appearance.windows.one-window-ratio-off": {"icon":"","label":"Disable 1-Window Ratio","when":"quattro-hyprland-toggle --enabled single-window-aspect-ratio","action":"quattro-hyprland-window single-square-aspect-toggle"},
  "appearance.branding": {"icon":"","iconFont":"quattro","label":"Branding"},
  "appearance.branding.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "appearance.branding.about": {"icon":"","label":"About"},
  "appearance.branding.about.text": {"icon":"","label":"Edit Text","action":"quattro-branding about text"},
  "appearance.branding.about.default": {"icon":"","label":"Restore Default","action":"quattro-branding about reset"},
  "appearance.branding.screensaver.text": {"icon":"","label":"Edit Text","action":"quattro-branding screensaver text"},
  "appearance.branding.screensaver.default": {"icon":"","label":"Restore Default","action":"quattro-branding screensaver reset"},
  "appearance.dock": {"icon":"󱂩","label":"Dock","when":"[[ $(quattro-hyprland-workspace-layout current) == \"floating\" ]]"},
  "appearance.dock.autohide": {"icon":"󰈉","label":"Auto-hide Dock","when":"[[ $(quattro-dock autohide) == \"off\" ]]","action":"quattro-dock autohide on"},
  "appearance.dock.always-on": {"icon":"󰈈","label":"Always-on Dock","when":"[[ $(quattro-dock autohide) == \"on\" ]]","action":"quattro-dock autohide off"},
  "appearance.dock.position": {"icon":"","label":"Dock Position"},
  "appearance.dock.position.top": {"icon":"󰁝","label":"Top Dock","checked":"[[ $(quattro-dock position) == \"top\" ]]","action":"quattro-dock position top"},
  "appearance.dock.position.bottom": {"icon":"󰁅","label":"Bottom Dock","checked":"[[ $(quattro-dock position) == \"bottom\" ]]","action":"quattro-dock position bottom"},
  "appearance.dock.position.left": {"icon":"󰁍","label":"Left Dock","checked":"[[ $(quattro-dock position) == \"left\" ]]","action":"quattro-dock position left"},
  "appearance.dock.position.right": {"icon":"󰁔","label":"Right Dock","checked":"[[ $(quattro-dock position) == \"right\" ]]","action":"quattro-dock position right"},
  "appearance.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","title":"Default Workspace Layout"},
  "appearance.workspace-layout.dwindle": {"icon":"󱓻","label":"Tiling","checked":"[[ $(quattro-hyprland-workspace-layout default) == \"dwindle\" ]]","action":"quattro-hyprland-workspace-layout default dwindle"},
  "appearance.workspace-layout.scrolling": {"icon":"󰝥","label":"Scrolling","checked":"[[ $(quattro-hyprland-workspace-layout default) == \"scrolling\" ]]","action":"quattro-hyprland-workspace-layout default scrolling"},
  "appearance.workspace-layout.floating": {"icon":"󰔶","label":"Floating","checked":"[[ $(quattro-hyprland-workspace-layout default) == \"floating\" ]]","action":"quattro-hyprland-workspace-layout default floating"},
  "appearance.animations-on": {"icon":"󰗘","label":"Animations On","when":"quattro-hyprland-toggle --animations-off","action":"quattro-toggle animations"},
  "appearance.animations-off": {"icon":"󰗘","label":"Animations Off","when":"! quattro-hyprland-toggle --animations-off","action":"quattro-toggle animations"},

  // Trigger
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.toggle.idle-lock-on": {"icon":"","label":"Stay Awake","when":"[[ ! -f ~/.local/state/quattro/indicators/stay-awake ]]","action":"quattro-toggle idle"},
  "trigger.toggle.idle-lock-off": {"icon":"","label":"Allow Sleep","when":"[[ -f ~/.local/state/quattro/indicators/stay-awake ]]","action":"quattro-toggle idle"},
  "trigger.toggle.notifications-on": {"icon":"󰂛","label":"Notifications On","when":"[[ $(quattro-shell notifications isDnd) == on ]]","action":"quattro-toggle notification-silencing"},
  "trigger.toggle.notifications-off": {"icon":"󰂛","label":"Silence Notifications","when":"[[ $(quattro-shell notifications isDnd) != on ]]","action":"quattro-toggle notification-silencing"},
  "trigger.toggle.nightlight-on": {"icon":"󰔎","label":"Nightlight On","when":"[[ $(quattro-toggle nightlight --status) != *'\"enabled\":true'* ]]","action":"quattro-toggle nightlight"},
  "trigger.toggle.nightlight-off": {"icon":"󰔎","label":"Nightlight Off","when":"[[ $(quattro-toggle nightlight --status) == *'\"enabled\":true'* ]]","action":"quattro-toggle nightlight"},
  "trigger.toggle.screensaver-on": {"icon":"󱄄","label":"Screensaver On","when":"quattro-toggle --enabled screensaver-off","action":"quattro-toggle screensaver"},
  "trigger.toggle.screensaver-off": {"icon":"󱄄","label":"Screensaver Off","when":"! quattro-toggle --enabled screensaver-off","action":"quattro-toggle screensaver"},
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"quattro-menu emoji"},
  "trigger.clipboard-history": {"icon":"󰅇","label":"Clipboard History","action":"quattro-shell shell summon quattro.clipboard"},
  "trigger.reminder": {"icon":"󰀠","label":"Reminder","aliases":["reminder","reminders"]},
  "trigger.reminder.set": {"icon":"󰀠","label":"Set Reminder","aliases":["reminder-set"],"action":"quattro-launch-floating-terminal-with-presentation quattro-reminder"},
  "trigger.reminder.list": {"icon":"󰉺","label":"Active Reminders","action":"quattro-launch-floating-terminal-with-presentation quattro-reminder list"},
  "trigger.reminder.cancel": {"icon":"󰅖","label":"Cancel Reminder","action":"quattro-launch-floating-terminal-with-presentation quattro-reminder cancel"},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"quattro-capture-screenshot"},
  "trigger.capture.screenshot-edit": {"icon":"󰏫","label":"Screenshot & Edit","action":"quattro-capture-screenshot edit"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"quattro-capture-screenrecording --status","action":"quattro-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"quattro-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"quattro-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"quattro-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"quattro-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"quattro-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"quattro-hw webcam","action":"quattro-capture-screenrecording --pick-webcam"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display-on": {"icon":"󰛧","label":"Laptop Display On","when":"quattro-hw laptop && quattro-hyprland-toggle --enabled internal-monitor-disable","action":"quattro-hyprland-monitor internal toggle"},
  "trigger.hardware.laptop-display-off": {"icon":"󰛧","label":"Laptop Display Off","when":"quattro-hw laptop && ! quattro-hyprland-toggle --enabled internal-monitor-disable","action":"quattro-hyprland-monitor internal toggle"},
  "trigger.hardware.mirror-display-on": {"icon":"󰍹","label":"Display Mirroring On","when":"quattro-hw laptop && ! quattro-hyprland-toggle --enabled internal-monitor-mirror","action":"quattro-hyprland-monitor internal-mirror toggle"},
  "trigger.hardware.mirror-display-off": {"icon":"󰍹","label":"Display Mirroring Off","when":"quattro-hw laptop && quattro-hyprland-toggle --enabled internal-monitor-mirror","action":"quattro-hyprland-monitor internal-mirror toggle"},
  "trigger.hardware.touchpad-on": {"icon":"󰟸","label":"Enable Touchpad","when":"[[ -n $(quattro-hw touchpad) && -f ~/.local/state/quattro/toggles/hypr/touchpad-disabled-name ]]","action":"quattro-toggle touchpad"},
  "trigger.hardware.touchpad-off": {"icon":"󰟸","label":"Disable Touchpad","when":"[[ -n $(quattro-hw touchpad) && ! -f ~/.local/state/quattro/toggles/hypr/touchpad-disabled-name ]]","action":"quattro-toggle touchpad"},
  "trigger.hardware.touchscreen-on": {"icon":"󰆽","label":"Enable Touchscreen","when":"[[ -n $(quattro-hw touchscreen) && -f ~/.local/state/quattro/toggles/hypr/touchscreen-disabled-name ]]","action":"quattro-toggle touchscreen"},
  "trigger.hardware.touchscreen-off": {"icon":"󰆽","label":"Disable Touchscreen","when":"[[ -n $(quattro-hw touchscreen) && ! -f ~/.local/state/quattro/toggles/hypr/touchscreen-disabled-name ]]","action":"quattro-toggle touchscreen"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"quattro-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"quattro-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"quattro-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"quattro-shell shell summon quattro.speedtest"},

  // Setup
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","checked":"[[ \"$(quattro-default browser)\" == \"chromium\" ]]","action":"quattro-default browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","checked":"[[ \"$(quattro-default browser)\" == \"chrome\" ]]","action":"quattro-default browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","checked":"[[ \"$(quattro-default browser)\" == \"brave\" ]]","action":"quattro-default browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","checked":"[[ \"$(quattro-default browser)\" == \"brave-origin\" ]]","action":"quattro-default browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","checked":"[[ \"$(quattro-default browser)\" == \"edge\" ]]","action":"quattro-default browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","checked":"[[ \"$(quattro-default browser)\" == \"firefox\" ]]","action":"quattro-default browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","checked":"[[ \"$(quattro-default browser)\" == \"zen\" ]]","action":"quattro-default browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
