  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"quattro-hw-fingerprint","action":"quattro-launch-floating-terminal-with-presentation quattro-setup-security-fingerprint"},
