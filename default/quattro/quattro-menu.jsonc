  "setup.security.ssh-agent": {"icon":"󰣀","label":"SSH Agent","when":"! systemctl --user -q is-enabled gcr-ssh-agent.socket","action":"quattro-launch-floating-terminal-with-presentation 'quattro-setup-security ssh-agent'"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"quattro-launch-floating-terminal-with-presentation quattro-sudo-passwordless"},
  "setup.config.git": {"icon":"","label":"Git","action":"quattro-launch-floating-terminal-with-presentation quattro-setup-git"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"quattro-launch-editor --notify \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"quattro-launch-editor --wait --notify ~/.config/hypr/hyprsunset.conf && quattro-restart hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"quattro-launch-editor --wait --notify ~/.XCompose && quattro-restart xcompose"},
  "setup.keyboard": {"icon":"","label":"Keyboard"},
  "setup.keyboard.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"quattro-launch-editor --notify \"$HOME/.config/hypr/bindings.lua\""},
  "setup.keyboard.inputs": {"icon":"","label":"Keyboard Inputs","action":"quattro-setup-keyboard"},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"quattro-launch-editor --notify \"$HOME/.config/hypr/input.lua\""},
  "setup.monitors": {"icon":"󰍹","label":"Monitors","when":"[[ -f ~/.config/hypr/monitors.lua ]]","action":"quattro-launch-editor --notify \"$HOME/.config/hypr/monitors.lua\""},
